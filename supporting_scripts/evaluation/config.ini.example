; Copy to config.ini (untracked) and fill in the credentials of the instance under test.
[Settings]
; Account used for every run. Must be at least editor in the evaluation course; jobs are per-user scoped.
user = CHANGE_ME
password = CHANGE_ME
server_url = http://localhost:8080/api

[Corpus]
course_name = Variant Evaluation Course
course_short_name = varianteval
programming_title = Sorting Strategy
programming_short_name = sortingstrategy
package_name = de.tum.cit.aet.sorting
quiz_title = Design Patterns Quiz

[Run]
; Glob matching every instance log the harness slices runs out of (see local/eval/start-server.sh).
; Deliberately a glob over the real files, not the instance.log symlink: start-server.sh repoints that
; symlink on every restart, so a harness following it would read a file that is no longer live, and a run
; whose lines straddle a restart would silently lose half of them. Each run records which log file its
; lines came from.
instance_log_glob = ../../local/eval/instance-*.log
; Concurrency for programming runs, decided by the timing measurement in Stage 0 step 10.
concurrency = 3
; Per-run timeout before the harness cancels and records TIMEOUT.
timeout_seconds = 2700
poll_seconds = 2