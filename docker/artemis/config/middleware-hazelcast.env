# ----------------------------------------------------------------------------------------------------------------------
# Distributed data backend: the embedded Hazelcast cluster.
#
# Selected by the multi-node E2E runners with `--middleware hazelcast` (the default). Hazelcast needs no external
# container: each Artemis node embeds a member (or, on a pure build agent, a client) and they find each other through
# Eureka.
# ----------------------------------------------------------------------------------------------------------------------
ARTEMIS_DISTRIBUTEDDATA_PROVIDER="Hazelcast"
