# The following enables the Java Remote Debugging port. More infos in the documentation:
# https://docs.artemis.tum.de/developer/docker-debugging
_JAVA_OPTIONS: -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005

SPRING_PROFILES_ACTIVE: artemis,scheduling,localci,localvc,buildagent,core,dev,docker,sharing

# Every core node refuses to start without installation metadata. Replace these to show your own on the About page.
INFO_OPERATORNAME="Artemis Development Operations"
INFO_OPERATORADMINNAME="Artemis Development Administrator"
INFO_UNIVERSITYNAME="Artemis Development University"

# Integrated Code Lifecycle settings with Jira
ARTEMIS_USERMANAGEMENT_USEEXTERNAL="false"

# Overwrite Docker URI Connection for Windows
#ARTEMIS_CONTINUOUSINTEGRATION_DOCKERCONNECTIONURI="tcp://host.docker.internal:2375"
