EUREKA_CLIENT_REGISTERWITHEUREKA=false
EUREKA_CLIENT_FETCHREGISTRY=false

# Nginx forwards the git ssh port at the TCP level and announces the real client with a PROXY protocol header
# (proxy_protocol on, see docker/nginx/nginx.conf). Without this, the ssh server would attribute every connection to
# nginx: git ssh rate limiting would share one bucket across all users and the access log would record the proxy.
# Scoped to the docker bridge ranges, which is where nginx sits, because compose assigns container addresses
# dynamically and there is no single address to name. Anything able to connect from inside these ranges could forge a
# client address, which is acceptable here only because a compose test stack is not a trust boundary and nothing else
# reaches port 7921 in it. A production deployment must name its load balancer exactly instead.
ARTEMIS_VERSIONCONTROL_SSHPROXYPROTOCOL_TRUSTEDSOURCES="172.16.0.0/12,10.0.0.0/8,192.168.0.0/16"
