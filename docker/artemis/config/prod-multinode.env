# ----------------------------------------------------------------------------------------------------------------------
# Artemis configurations for Prod Artemis setups
# ----------------------------------------------------------------------------------------------------------------------
# Secret Overrides
# ----------------------------------------------------------------------------------------------------------------------
# Change these default secrets in another not-commited environment override file for prod systems!
# ----------------------------------------------------------------------------------------------------------------------
# Local-stack credentials. Deliberately not the values published elsewhere in this repository: these files activate the
# `prod` profile, and ConfigurationValidator refuses to start a production profile on a credential that anyone can read in
# the Artemis repository. They exist so the local prod-profile stacks boot, and are useless for anything else - never reuse
# them for a deployment.
ARTEMIS_ATHENA_SECRET="abcdefg12345"
ARTEMIS_USERMANAGEMENT_INTERNALADMIN_USERNAME="artemis_admin"
# checkov:skip=CKV_SECRET_6: fixture credential of the local E2E/multi-node stacks, not a deployment secret
ARTEMIS_USERMANAGEMENT_INTERNALADMIN_PASSWORD="local-e2e-admin-not-a-deployment-credential"

SPRING_DATASOURCE_USERNAME="root"
SPRING_DATASOURCE_PASSWORD=""

SPRING_MAIL_USERNAME=""
SPRING_MAIL_PASSWORD=""

# ----------------------------------------------------------------------------------------------------------------------
# Plain Prod Artemis Overrides
# ----------------------------------------------------------------------------------------------------------------------
# Keep these at a minimum! Try to change the default values either in the application-docker.yml or even better
# in one of the other application.yml or application-*.yml files.
# ----------------------------------------------------------------------------------------------------------------------
ARTEMIS_USERMANAGEMENT_USEEXTERNAL="false"

SPRING_WEBSOCKET_BROKER_USERNAME="guest"
SPRING_WEBSOCKET_BROKER_PASSWORD="guest"
SPRING_WEBSOCKET_BROKER_ADDRESSES='artemis-activemq-broker:61613'

EUREKA_CLIENT_ENABLED=true
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE="http://admin:admin@artemis-jhipster-registry:8761/eureka/"
EUREKA_INSTANCE_PREFERIPADDRESS=true
EUREKA_INSTANCE_APPNAME='Artemis'

JHIPSTER_REGISTRY_PASSWORD="admin"
# Generated per run by the runner scripts, see playwright.env.
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64SECRET="${ARTEMIS_E2E_JWT_SECRET:?not set. Use one of the E2E runner scripts, or export it yourself: the output of openssl rand -base64 64, joined into a single line}"

ARTEMIS_VERSIONCONTROL_URL='http://artemis-app-node-2:8080'
ARTEMIS_VERSIONCONTROL_USER='artemis_admin'
ARTEMIS_VERSIONCONTROL_PASSWORD='local-e2e-admin-not-a-deployment-credential'
ARTEMIS_VERSIONCONTROL_BUILDAGENTGITUSERNAME='buildjob_user'
# checkov:skip=CKV_SECRET_6: fixture credential of the local E2E/multi-node stacks, not a deployment secret
ARTEMIS_VERSIONCONTROL_BUILDAGENTGITPASSWORD='local-e2e-buildagent-not-a-deployment-credential'
ARTEMIS_CONTINUOUSINTEGRATION_ARTEMISAUTHENTICATIONTOKENVALUE='demo'
ARTEMIS_CONTINUOUSINTEGRATION_DOCKERCONNECTIONURI='unix:///var/run/docker.sock'
ARTEMIS_GIT_NAME='artemis'
ARTEMIS_GIT_EMAIL='artemis@example.com'

# Nginx forwards the git ssh port at the TCP level and announces the real client with a PROXY protocol header
# (proxy_protocol on, see docker/nginx/nginx.conf). Without this, the ssh server would attribute every connection to
# nginx: git ssh rate limiting would share one bucket across all users and the access log would record the proxy.
# Scoped to the docker bridge ranges, which is where nginx sits. A connection from any other address is handled as
# ordinary ssh, so a direct connection is unaffected and nobody outside these ranges can forge a client address.
ARTEMIS_VERSIONCONTROL_SSHPROXYPROTOCOL_TRUSTEDSOURCES="172.16.0.0/12,10.0.0.0/8,192.168.0.0/16"
