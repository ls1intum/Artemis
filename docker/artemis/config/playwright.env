# ----------------------------------------------------------------------------------------------------------------------
# Common Artemis configurations for the Playwright E2E Postgres setups
# ----------------------------------------------------------------------------------------------------------------------

SPRING_DATASOURCE_PASSWORD=""
SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE="100"

SPRING_PROMETHEUS_MONITORINGIP="131.159.89.160"

# 54321 is internally open for the build agents that execute the e2e tests
# also can't use SSL for this as the hostnames are not integrated in the self-signed certificate
SERVER_URL="http://${HOST_HOSTNAME}:54321"

# We don't need secure passwords for testing. Lower rounds will speed up tests. 4 is the lowest
ARTEMIS_BCRYPTSALTROUNDS="4"

ARTEMIS_USERMANAGEMENT_INTERNALADMIN_USERNAME="${ARTEMIS_ADMIN_USERNAME}"
# Not ${ARTEMIS_ADMIN_PASSWORD}: these stacks run under the prod profile, which refuses to start on the published
# `artemis_admin` value or on a password equal to the username. The admin here is a fixture account, so the value is
# fixed in the repository and mirrored to Playwright in docker/playwright.yml.
# checkov:skip=CKV_SECRET_6: fixture credential of the local E2E/multi-node stacks, not a deployment secret
ARTEMIS_USERMANAGEMENT_INTERNALADMIN_PASSWORD="local-e2e-admin-not-a-deployment-credential"
ARTEMIS_USERMANAGEMENT_LOGIN_ACCOUNTNAME="TUM"
ARTEMIS_USERMANAGEMENT_PASSKEY_ENABLED="true"
ARTEMIS_USERMANAGEMENT_PASSKEY_RELYINGPARTYID="artemis-nginx"
ARTEMIS_USERMANAGEMENT_PASSKEY_ADDITIONALALLOWEDORIGINS="https://artemis-nginx,http://localhost:9000"

ARTEMIS_CONTINUOUSINTEGRATION_EMPTYCOMMITNECESSARY="true"
# Use minimal C Docker image for faster E2E builds
ARTEMIS_CONTINUOUSINTEGRATION_BUILD_IMAGES_C_DEFAULT="ls1tum/artemis-c-minimal-docker:1.0.0"

ARTEMIS_APOLLON_CONVERSIONSERVICEURL="https://apollon.ase.in.tum.de/api/converter"

ARTEMIS_TELEMETRY_ENABLED="false"

# Generated per run by the runner scripts rather than committed: a signing key that lives in the repository is a key
# anyone can use to forge a token, so ConfigurationValidator rejects the values this repository publishes, and these
# stacks run under the prod profile. Every service here reads this file, so all of them share one key.
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64SECRET="${ARTEMIS_E2E_JWT_SECRET:?not set. Use one of the E2E runner scripts, or export it yourself: the output of openssl rand -base64 64, joined into a single line}"

# The prod profile also rejects the `buildjob_password` shipped in application-buildagent.yml / application-localvc.yml,
# which the LocalCI stacks would otherwise inherit. Artemis and the build agent run in the same container here, so one
# value covers both sides.
# checkov:skip=CKV_SECRET_6: fixture credential of the local E2E/multi-node stacks, not a deployment secret
ARTEMIS_VERSIONCONTROL_BUILDAGENTGITPASSWORD="local-e2e-buildagent-not-a-deployment-credential"

# Token is valid 3 days
JHIPSTER_SECURITY_AUTHENTICATION_JWT_TOKENVALIDITYINSECONDS="259200"
# Token is valid 30 days
JHIPSTER_SECURITY_AUTHENTICATION_JWT_TOKENVALIDITYINSECONDSFORREMEMBERME="2592000"

# Properties to be exposed on the /management/info endpoint.
# These INFO_* names are all-uppercase by env-var convention; they map to the camelCase info.* keys defined in application.yml
# (INFO_TESTSERVER -> info.testServer). DeduplicatedEnvironmentInfoContributor normalizes them back to camelCase on the endpoint.
INFO_TESTSERVER="true"
INFO_TEXTASSESSMENTANALYTICSENABLED="true"
INFO_STUDENTEXAMSTORESESSIONDATA="true"
INFO_OPERATORNAME="TUM"

LOGGING_FILE_NAME="/opt/artemis/data/artemis.log"

MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED="true"

# Activate E2E seed data via Liquibase
SPRING_LIQUIBASE_CONTEXTS="prod,e2e"

# Activate runtime slow-query detection (thesis objective 4.4).
# Wraps the JDBC DataSource with a datasource-proxy interceptor that records
# queries exceeding the configured threshold and exposes them via
# GET /api/core/admin/performance/slow-queries for CI reporting.
SPRING_PROFILES_INCLUDE="e2e-performance"
