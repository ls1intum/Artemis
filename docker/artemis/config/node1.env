SPRING_PROFILES_ACTIVE='prod,localvc,localci,core,scheduling,docker'
EUREKA_INSTANCE_INSTANCEID='Artemis:1'
EUREKA_INSTANCE_HOSTNAME='artemis-app-node-1'
SPRING_HAZELCAST_INTERFACE='artemis-app-node-1'

#INFO_OPERATORNAME='Some Artemis Dev' # uncomment for local dev multinode setup
# Enable LTI so the cross-node LTI test in DistributedStateCoherence.spec.ts runs. The signing key of each LTI
# platform lives in a distributed map, so a key written on one core node has to be served by the other core node's
# JWKS endpoint. Core nodes only: a build-agent node has no LTI repositories and refuses to start with LTI on.
ARTEMIS_LTI_ENABLED="true"
