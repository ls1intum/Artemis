{
    "name": "@tumaet/ui-angular",
    "version": "0.1.0",
    "private": true,
    "description": "Signal-first Angular UI components for TUM applications",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ls1intum/Artemis.git",
        "directory": "packages/tum-ui"
    },
    "files": [
        "fesm2022",
        "types",
        "styles.css",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "pnpm run build:styles && pnpm run build:package && pnpm run check:styles",
        "build:dev": "pnpm run build:styles && pnpm run build:package:dev && pnpm run check:styles",
        "build:package": "ng-packagr -p ng-package.json -c tsconfig.lib.prod.json",
        "build:package:dev": "ng-packagr -p ng-package.dev.json -c tsconfig.lib.json",
        "build:package:watch": "ng-packagr -p ng-package.dev.json -c tsconfig.lib.json --watch",
        "build:styles": "node build-styles.mjs",
        "build:watch": "pnpm run build:styles -- --development && concurrently --kill-others --names package,styles \"pnpm run build:package:watch\" \"node build-styles.mjs --development --watch\"",
        "check:styles": "node check-styles.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "pack:check": "pnpm run build:styles && ng-packagr -p ng-package.pack.json -c tsconfig.lib.prod.json && node check-styles.mjs --package-dir dist-pack && publint --strict dist-pack && attw --pack dist-pack --entrypoints . --profile esm-only",
        "stylelint": "stylelint \"{src,.storybook}/**/*.{css,scss}\" \"{tailwind,tailwind-theme,themes}.css\"",
        "test": "ng test tum-ui --no-watch --no-progress",
        "test:coverage": "ng test tum-ui --no-watch --no-progress --coverage",
        "test:watch": "ng test tum-ui",
        "storybook": "pnpm run build:styles -- --development && pnpm run storybook:docs && concurrently --kill-others --names styles,storybook \"node build-styles.mjs --development --watch\" \"storybook dev --port 6006 --no-open\"",
        "storybook:build": "pnpm run storybook:prepare && pnpm run storybook:build:prepared",
        "storybook:build:prepared": "storybook build --output-dir ../../build/storybook/tum-ui",
        "storybook:docs": "compodoc -p tsconfig.lib.json -e json -d . --silent",
        "storybook:docs:test": "pnpm run storybook:build && pnpm run storybook:docs:test:built",
        "storybook:docs:test:built": "playwright test --config .storybook/playwright.config.ts",
        "storybook:prepare": "pnpm run build:styles -- --development && pnpm run storybook:docs",
        "storybook:test": "pnpm run storybook:prepare && pnpm run storybook:test:prepared",
        "storybook:test:prepared": "vitest run --config vitest.storybook.config.ts",
        "storybook:typecheck": "pnpm run storybook:docs && pnpm run storybook:typecheck:prepared",
        "storybook:typecheck:prepared": "tsc --noEmit --project .storybook/tsconfig.json",
        "storybook:validate": "pnpm run storybook:prepare && pnpm run storybook:typecheck:prepared && pnpm run storybook:test:prepared && pnpm run storybook:build:prepared && pnpm run storybook:docs:test:built"
    },
    "exports": {
        "./styles.css": "./styles.css"
    },
    "peerDependencies": {
        "@angular/cdk": "22.1.5",
        "@angular/common": "22.1.5",
        "@angular/core": "22.1.5",
        "@angular/forms": "22.1.5",
        "@fortawesome/angular-fontawesome": "5.1.0",
        "@fortawesome/fontawesome-svg-core": "7.3.1",
        "@fortawesome/free-solid-svg-icons": "7.3.1",
        "rxjs": "7.8.2"
    },
    "dependencies": {
        "dayjs": "1.11.23",
        "lodash-es": "4.18.1",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@angular-devkit/architect": "catalog:",
        "@angular-devkit/core": "catalog:",
        "@angular/build": "catalog:",
        "@angular/cdk": "catalog:",
        "@angular/cli": "catalog:",
        "@angular/common": "catalog:",
        "@angular/compiler": "catalog:",
        "@angular/compiler-cli": "catalog:",
        "@angular/core": "catalog:",
        "@angular/forms": "catalog:",
        "@angular/localize": "catalog:",
        "@angular/platform-browser": "catalog:",
        "@arethetypeswrong/cli": "catalog:",
        "@compodoc/compodoc": "catalog:",
        "@fortawesome/angular-fontawesome": "catalog:",
        "@fortawesome/fontawesome-svg-core": "catalog:",
        "@fortawesome/free-solid-svg-icons": "catalog:",
        "@playwright/test": "catalog:",
        "@storybook/addon-a11y": "catalog:",
        "@storybook/addon-docs": "catalog:",
        "@storybook/addon-themes": "catalog:",
        "@storybook/addon-vitest": "catalog:",
        "@storybook/angular-vite": "catalog:",
        "@tailwindcss/postcss": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@vitest/browser": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "chokidar": "catalog:",
        "concurrently": "catalog:",
        "eslint": "catalog:",
        "ng-packagr": "catalog:",
        "playwright": "catalog:",
        "postcss": "catalog:",
        "publint": "catalog:",
        "react": "catalog:",
        "rxjs": "catalog:",
        "sass": "catalog:",
        "storybook": "catalog:",
        "stylelint": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:",
        "zone.js": "catalog:"
    },
    "sideEffects": [
        "./styles.css"
    ]
}
