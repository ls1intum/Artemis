{
    "name": "@tumaet/ui-angular",
    "version": "0.1.0",
    "private": true,
    "description": "Signal-first Angular UI components for TUM applications",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ls1intum/Artemis.git",
        "directory": "packages/tum-ui"
    },
    "scripts": {
        "storybook": "node build-styles.mjs && pnpm run storybook:docs && concurrently --kill-others --names styles,storybook \"node build-styles.mjs --watch\" \"storybook dev --port 6006 --no-open\"",
        "storybook:build": "node build-styles.mjs && pnpm run storybook:docs && storybook build --output-dir ../../build/storybook/tum-ui",
        "storybook:docs": "compodoc -p tsconfig.lib.json -e json -d . --silent",
        "storybook:docs:test": "pnpm run storybook:build && pnpm run storybook:docs:test:built",
        "storybook:docs:test:built": "playwright test --config .storybook/playwright.config.ts",
        "storybook:test": "node build-styles.mjs && pnpm run storybook:docs && vitest run --config vitest.storybook.config.ts",
        "storybook:typecheck": "pnpm run storybook:docs && tsc --noEmit --project .storybook/tsconfig.json"
    },
    "exports": {
        "./styles.css": "./styles.css"
    },
    "peerDependencies": {
        "@angular/cdk": "22.1.0",
        "@angular/common": "22.1.0",
        "@angular/core": "22.1.0",
        "@angular/forms": "22.1.0",
        "@fortawesome/angular-fontawesome": "5.1.0",
        "@fortawesome/fontawesome-svg-core": "7.3.1",
        "@fortawesome/free-solid-svg-icons": "7.3.1",
        "rxjs": "7.8.2"
    },
    "dependencies": {
        "dayjs": "1.11.21",
        "lodash-es": "4.18.1",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@analogjs/vite-plugin-angular": "catalog:",
        "@angular-devkit/architect": "catalog:",
        "@angular-devkit/core": "catalog:",
        "@angular/animations": "catalog:",
        "@angular/build": "catalog:",
        "@angular/compiler": "catalog:",
        "@angular/compiler-cli": "catalog:",
        "@angular/platform-browser": "catalog:",
        "@compodoc/compodoc": "catalog:",
        "@playwright/test": "catalog:",
        "@storybook/addon-a11y": "catalog:",
        "@storybook/addon-docs": "catalog:",
        "@storybook/addon-themes": "catalog:",
        "@storybook/addon-vitest": "catalog:",
        "@storybook/angular-vite": "catalog:",
        "@tailwindcss/postcss": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@vitest/browser": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "chokidar": "catalog:",
        "concurrently": "catalog:",
        "playwright": "catalog:",
        "postcss": "catalog:",
        "react": "catalog:",
        "sass": "catalog:",
        "storybook": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:storybook",
        "vitest": "catalog:"
    },
    "sideEffects": [
        "./styles.css"
    ]
}
