{
    "version": 1,
    "projects": {
        "consumer": {
            "projectType": "application",
            "root": "",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "browser": "main.ts",
                        "index": "index.html",
                        "tsConfig": "tsconfig.json",
                        "outputPath": "dist",
                        "styles": ["@tumaet/ui-angular/styles.css"],
                        "budgets": [{ "type": "initial", "maximumError": "600kB" }]
                    }
                }
            }
        }
    },
    "cli": { "analytics": false }
}
