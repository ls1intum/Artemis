{
    "extends": ["stylelint-config-standard", "stylelint-config-html"],
    "overrides": [
        {
            "files": ["**/*.html"],
            "customSyntax": "postcss-html"
        },
        {
            "files": ["documentation/**/*.module.css"],
            "rules": {
                "selector-pseudo-class-no-unknown": [
                    true,
                    {
                        "ignorePseudoClasses": ["global"]
                    }
                ]
            }
        },
        {
            "files": ["src/main/webapp/tailwind.css", "packages/tum-aet-ui/tailwind.css", "packages/tum-aet-ui/tailwind-theme.css"],
            "rules": {
                "at-rule-prelude-no-invalid": null,
                "at-rule-no-unknown": [
                    true,
                    {
                        "ignoreAtRules": ["custom-variant", "source", "theme", "utility"]
                    }
                ]
            }
        },
        {
            "files": [
                "src/main/webapp/app/shared-ui/form/title-channel-name/**/*.css",
                "src/main/webapp/app/shared-ui/user-import/**/*.css",
                "src/main/webapp/app/shared-ui/confirm-entity-name/**/*.css",
                "src/main/webapp/app/shared-ui/delete-dialog/**/*.css",
                "src/main/webapp/app/shared-ui/profile-picture/**/*.css",
                "src/main/webapp/app/shared-ui/components/buttons/copy-to-clipboard-button/**/*.css",
                "src/main/webapp/app/quiz/manage/apollon-diagrams/**/*.css",
                "src/main/webapp/app/quiz/manage/question-reevaluation-actions/**/*.css",
                "src/main/webapp/app/quiz/manage/statistics/question-statistics-chart/**/*.css",
                "packages/tum-aet-ui/src/lib/**/*.css",
                "src/main/webapp/app/account/**/*.css",
                "src/main/webapp/app/admin/**/*.css",
                "src/main/webapp/app/aiworker/**/*.css",
                "src/main/webapp/app/assessment/**/*.css",
                "src/main/webapp/app/calendar/**/*.css",
                "src/main/webapp/app/communication/**/*.css",
                "src/main/webapp/app/exam/**/*.css",
                "src/main/webapp/app/exercise/**/*.css",
                "src/main/webapp/app/fileupload/**/*.css",
                "src/main/webapp/app/foundation/**/*.css",
                "src/main/webapp/app/hyperion/**/*.css",
                "src/main/webapp/app/iris/**/*.css",
                "src/main/webapp/app/lecture/**/*.css",
                "src/main/webapp/app/localci/**/*.css",
                "src/main/webapp/app/localvc/**/*.css",
                "src/main/webapp/app/logos/**/*.css",
                "src/main/webapp/app/lti/**/*.css",
                "src/main/webapp/app/modeling/**/*.css",
                "src/main/webapp/app/notification/**/*.css",
                "src/main/webapp/app/plagiarism/**/*.css",
                "src/main/webapp/app/presentation/**/*.css",
                "src/main/webapp/app/quiz/**/*.css",
                "src/main/webapp/app/shared/**/*.css",
                "src/main/webapp/app/shared-ui/**/*.css",
                "src/main/webapp/app/sharing/**/*.css",
                "src/main/webapp/app/tutorialgroup/**/*.css",
                "src/main/webapp/app/videosource/**/*.css",
                "src/main/webapp/app/atlas/**/*.css",
                "src/main/webapp/app/editor/**/*.css",
                "src/main/webapp/app/text/**/*.css",
                "src/main/webapp/app/core/**/*.css",
                "src/main/webapp/app/course/**/*.css",
                "src/main/webapp/app/programming/**/*.css",
                "src/main/webapp/app/app.component.css",
                "src/main/webapp/app/quiz/manage/detail/**/*.css",
                "src/main/webapp/app/quiz/manage/manage-buttons/**/*.css",
                "src/main/webapp/app/quiz/manage/lifecyle-buttons/**/*.css",
                "src/main/webapp/app/shared-ui/table-view/**/*.css",
                "src/main/webapp/app/shared-ui/components/buttons/button/**/*.css",
                "src/main/webapp/app/shared-ui/components/resizable-panels/**/*.css",
                "src/main/webapp/app/shared-ui/components/buttons/confirm-autofocus-button/**/*.css",
                "src/main/webapp/app/shared-ui/loading-indicator-overlay/**/*.css",
                "src/main/webapp/app/shared-ui/loading-indicator-container/**/*.css",
                "src/main/webapp/app/shared-ui/components/checklist-check/**/*.css",
                "src/main/webapp/app/shared-ui/information-box/**/*.css",
                "src/main/webapp/app/shared-ui/detail-overview-list/detail-overview-list.component.css"
            ],
            "rules": {
                "color-no-hex": true,
                "declaration-property-value-disallowed-list": {
                    "/.+/": ["/--bs-/", "/(?:rgb|hsl)a?\\(/"]
                }
            }
        },
        {
            "files": [
                "src/main/webapp/app/account/**/*.css",
                "src/main/webapp/app/admin/**/*.css",
                "src/main/webapp/app/aiworker/**/*.css",
                "src/main/webapp/app/assessment/**/*.css",
                "src/main/webapp/app/calendar/**/*.css",
                "src/main/webapp/app/communication/**/*.css",
                "src/main/webapp/app/exam/**/*.css",
                "src/main/webapp/app/exercise/**/*.css",
                "src/main/webapp/app/fileupload/**/*.css",
                "src/main/webapp/app/foundation/**/*.css",
                "src/main/webapp/app/hyperion/**/*.css",
                "src/main/webapp/app/iris/**/*.css",
                "src/main/webapp/app/lecture/**/*.css",
                "src/main/webapp/app/localci/**/*.css",
                "src/main/webapp/app/localvc/**/*.css",
                "src/main/webapp/app/logos/**/*.css",
                "src/main/webapp/app/lti/**/*.css",
                "src/main/webapp/app/modeling/**/*.css",
                "src/main/webapp/app/notification/**/*.css",
                "src/main/webapp/app/plagiarism/**/*.css",
                "src/main/webapp/app/presentation/**/*.css",
                "src/main/webapp/app/quiz/**/*.css",
                "src/main/webapp/app/shared/**/*.css",
                "src/main/webapp/app/shared-ui/**/*.css",
                "src/main/webapp/app/sharing/**/*.css",
                "src/main/webapp/app/tutorialgroup/**/*.css",
                "src/main/webapp/app/videosource/**/*.css",
                "src/main/webapp/app/atlas/**/*.css",
                "src/main/webapp/app/editor/**/*.css",
                "src/main/webapp/app/text/**/*.css",
                "src/main/webapp/app/core/**/*.css",
                "src/main/webapp/app/course/**/*.css",
                "src/main/webapp/app/programming/**/*.css",
                "src/main/webapp/app/app.component.css"
            ],
            "rules": {
                "declaration-property-value-disallowed-list": {
                    "/.+/": ["/--bs-/", "/(?:rgb|hsl)a?\\(/", "/--p-/"]
                },
                "selector-disallowed-list": [
                    "/(?:^|[\\s>+~,(])\\.(?:(?:btn|card|modal|dropdown|navbar|list-group|accordion|toast|popover|carousel|offcanvas|input-group)(?:-[\\w-]+)?|(?:badge|row|col|table|breadcrumb|breadcrumb-item|collapse|collapsing|nav|close|text-truncate|visually-hidden|pagination|page-link|page-item|text-muted)|alert(?:-(?:primary|secondary|success|danger|warning|info|light|dark|dismissible|link|heading))?|form-(?:control|select|group|label|text|range|floating|check|switch)(?:-[\\w-]+)?|col-(?:(?:sm|md|lg|xl|xxl)-)?(?:\\d{1,2}|auto)|table-(?:striped|bordered|borderless|hover|active|sm|responsive)(?:-[\\w-]+)?|spinner-(?:border|grow)(?:-sm)?|d-(?:none|inline|inline-block|block|grid|flex|inline-flex|table)|(?:justify-content|align-items|align-self)-[\\w-]+|flex-(?:column|fill|grow-[01]|shrink-[01])|(?:fw|fst|fs|lh)-[\\w-]+|(?:text|bg|border)-(?:danger|success|warning|info|light|dark|body|secondary)|rounded-(?:[0-5]|circle|pill))(?![\\w-])/",
                    "/(?:^|[\\s>+~,(])\\.?p-[a-z][\\w-]*/"
                ]
            }
        }
    ],
    "rules": {
        "max-nesting-depth": [
            0,
            {
                "ignoreAtRules": ["/.*/"],
                "message": "Do not nest style rules: the view encapsulation of Angular does not scope a nested selector like the flat one. Write the full selector."
            }
        ],
        "alpha-value-notation": "number",
        "import-notation": "string",
        "selector-no-invalid": null,
        "selector-no-unmatchable": null,
        "declaration-property-value-no-unknown": null,
        "media-feature-range-notation": "prefix",
        "selector-pseudo-element-no-unknown": [
            true,
            {
                "ignorePseudoElements": ["ng-deep"]
            }
        ],
        "at-rule-empty-line-before": [
            "always",
            {
                "except": ["first-nested", "blockless-after-same-name-blockless"],
                "ignore": ["after-comment", "inside-block"]
            }
        ],
        "font-family-no-missing-generic-family-keyword": [
            true,
            {
                "ignoreFontFamilies": ["codicon"]
            }
        ],
        "color-function-alias-notation": null,
        "color-function-notation": null,
        "no-descending-specificity": null,
        "selector-class-pattern": null,
        "selector-id-pattern": null,
        "comment-whitespace-inside": null,
        "property-no-vendor-prefix": null,
        "at-rule-no-vendor-prefix": null,
        "no-empty-source": null,
        "keyframes-name-pattern": null,
        "declaration-block-no-redundant-longhand-properties": null,
        "custom-property-pattern": null,
        "value-no-vendor-prefix": null,
        "selector-no-vendor-prefix": null,
        "no-duplicate-selectors": null,
        "selector-not-notation": null
    }
}
