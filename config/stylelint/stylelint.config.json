{
    "plugins": ["stylelint-scss"],
    "extends": ["stylelint-config-standard-scss", "stylelint-config-html"],
    "overrides": [
        {
            "files": ["**/*.scss"],
            "customSyntax": "postcss-scss"
        },
        {
            "files": ["**/*.html"],
            "customSyntax": "postcss-html"
        },
        {
            "files": ["documentation/**/*.module.css"],
            "rules": {
                "selector-pseudo-class-no-unknown": [
                    true,
                    {
                        "ignorePseudoClasses": ["global"]
                    }
                ]
            }
        },
        {
            "files": ["src/main/webapp/tailwind.css", "packages/tum-aet-ui/tailwind.css", "packages/tum-aet-ui/tailwind-theme.css"],
            "rules": {
                "scss/at-rule-no-unknown": [
                    true,
                    {
                        "ignoreAtRules": ["custom-variant", "plugin", "source", "theme"]
                    }
                ]
            }
        },
        {
            "files": [
                "src/main/webapp/app/admin/**/*.scss",
                "src/main/webapp/app/course/request/**/*.scss",
                "src/main/webapp/app/course/overview/course-statistics/**/*.scss",
                "src/main/webapp/app/exercise/result/**/*.scss",
                "src/main/webapp/app/iris/manage/settings/**/*.scss",
                "src/main/webapp/app/atlas/shared/standardized-competencies/**/*.scss",
                "src/main/webapp/app/atlas/shared/competency-selection/**/*.scss",
                "src/main/webapp/app/shared-ui/form/title-channel-name/**/*.scss",
                "src/main/webapp/app/exercise/exercise-title-channel-name/**/*.scss",
                "src/main/webapp/app/localci/build-queue/**/*.scss",
                "src/main/webapp/app/videosource/gocast/**/*.scss",
                "src/main/webapp/app/shared-ui/user-import/**/*.scss",
                "src/main/webapp/app/shared-ui/user-registration-modal/**/*.scss",
                "src/main/webapp/app/shared-ui/confirm-entity-name/**/*.scss",
                "src/main/webapp/app/shared-ui/delete-dialog/**/*.scss",
                "src/main/webapp/app/core/alert/**/*.scss",
                "src/main/webapp/app/core/about-us/**/*.scss",
                "src/main/webapp/app/core/feature-overview/**/*.scss",
                "src/main/webapp/app/core/layouts/footer/**/*.scss",
                "src/main/webapp/app/course/overview/setup-passkey-modal/**/*.scss",
                "src/main/webapp/app/notification/**/*.scss",
                "src/main/webapp/app/calendar/**/*.scss",
                "src/main/webapp/app/shared-ui/profile-picture/**/*.scss",
                "src/main/webapp/app/localci/build-agent-summary/**/*.scss",
                "src/main/webapp/app/localci/build-agent-details/**/*.scss",
                "src/main/webapp/app/localci/build-job-statistics/**/*.scss",
                "src/main/webapp/app/core/navbar/global-search/components/modal/global-search-modal.component.scss",
                "src/main/webapp/app/shared-ui/components/buttons/copy-to-clipboard-button/**/*.scss",
                "src/main/webapp/app/quiz/manage/apollon-diagrams/**/*.scss",
                "src/main/webapp/app/exam/**/*.scss",
                "src/main/webapp/app/exercise/example-solution/**/*.scss",
                "src/main/webapp/app/exercise/exercise-action-bar/**/*.scss",
                "src/main/webapp/app/exercise/exam-exercise-row-buttons/**/*.scss",
                "src/main/webapp/app/course/manage/user-management-dropdown/**/*.scss",
                "src/main/webapp/app/course/manage/update/**/*.scss",
                "src/main/webapp/app/account/**/*.scss",
                "src/main/webapp/app/lecture/**/*.scss",
                "src/main/webapp/app/tutorialgroup/**/*.scss",
                "src/main/webapp/app/shared-ui/components/resizable-panels/**/*.scss",
                "src/main/webapp/app/shared-ui/components/buttons/confirm-autofocus-button/**/*.scss",
                "src/main/webapp/app/shared-ui/loading-indicator-overlay/**/*.scss",
                "src/main/webapp/app/shared-ui/loading-indicator-container/**/*.scss",
                "src/main/webapp/app/shared-ui/components/checklist-check/**/*.scss",
                "src/main/webapp/app/shared-ui/information-box/**/*.scss",
                "src/main/webapp/app/course/shared/course-sidebar-toggle-button/**/*.scss",
                "src/main/webapp/app/atlas/shared/competency-contribution/**/*.scss",
                "src/main/webapp/app/atlas/manage/orchestration-trigger/**/*.scss",
                "src/main/webapp/app/atlas/shared/orchestration-result-dialog/**/*.scss",
                "src/main/webapp/app/shared-ui/detail-overview-list/detail-overview-list.component.scss",
                "src/main/webapp/app/exercise/participation/programming-exercise-participation-actions/**/*.scss",
                "src/main/webapp/app/quiz/manage/question-reevaluation-actions/**/*.scss",
                "src/main/webapp/app/exercise/statistics/statistics-span-selector/**/*.scss",
                "src/main/webapp/app/plagiarism/shared/case-header/**/*.scss",
                "src/main/webapp/app/communication/saved-posting-banner/**/*.scss",
                "src/main/webapp/app/communication/posting-create-edit-modal/post-create-edit-modal/**/*.scss",
                "src/main/webapp/app/quiz/manage/statistics/question-statistics-chart/**/*.scss",
                "packages/tum-aet-ui/src/lib/**/*.scss"
            ],
            "customSyntax": "postcss-scss",
            "rules": {
                "color-no-hex": true,
                "declaration-property-value-disallowed-list": {
                    "/.+/": ["/--bs-/", "/(?:rgb|hsl)a?\\(/"]
                }
            }
        }
    ],
    "rules": {
        "alpha-value-notation": "number",
        "media-feature-range-notation": "prefix",
        "selector-pseudo-element-no-unknown": [
            true,
            {
                "ignorePseudoElements": ["ng-deep"]
            }
        ],
        "at-rule-empty-line-before": [
            "always",
            {
                "except": ["first-nested", "blockless-after-same-name-blockless"],
                "ignore": ["after-comment", "inside-block"]
            }
        ],
        "font-family-no-missing-generic-family-keyword": [
            true,
            {
                "ignoreFontFamilies": ["codicon"]
            }
        ],
        "color-function-alias-notation": null,
        "color-function-notation": null,
        "no-descending-specificity": null,
        "selector-class-pattern": null,
        "selector-id-pattern": null,
        "scss/at-extend-no-missing-placeholder": null,
        "comment-whitespace-inside": null,
        "property-no-vendor-prefix": null,
        "at-rule-no-vendor-prefix": null,
        "scss/dollar-variable-empty-line-before": null,
        "scss/no-global-function-names": null,
        "no-empty-source": null,
        "keyframes-name-pattern": null,
        "declaration-block-no-redundant-longhand-properties": null,
        "scss/at-mixin-pattern": null,
        "scss/operator-no-unspaced": null,
        "scss/dollar-variable-pattern": null,
        "custom-property-pattern": null,
        "value-no-vendor-prefix": null,
        "selector-no-vendor-prefix": null,
        "no-duplicate-selectors": null,
        "selector-not-notation": null
    }
}
