    "scripts": {
        "build": "pnpm run webapp:prod --",
        "check:vite-override": "node supporting_scripts/check-vite-override.mjs",
        "clean-www": "rimraf build/resources/main/static/app/{src,build/}",
        "compile": "pnpm run prebuild && tsc --project tsconfig.app.json",
        "compile:tests": "pnpm run prebuild && tsc --project tsconfig.spec.json",
        "coverage:check-module": "node supporting_scripts/code-coverage/module-coverage-client/check-client-module-coverage.mjs",
        "coverage:pr": "node supporting_scripts/code-coverage/local-pr-coverage/local-pr-coverage.mjs",
        "docs:build": "pnpm --dir packages/tum-ui run storybook:prepare && pnpm run docs:build:prepared",
        "docs:build:prepared": "cross-env STORYBOOK_TUM_UI_GUIDE_URL=/developer/guidelines/tum-ui-kit pnpm --dir packages/tum-ui exec storybook build --output-dir ../../build/documentation-static/developer/tum-ui && node supporting_scripts/generate-tum-ui-reference-page.mjs && cross-env ARTEMIS_DOCS_TUM_UI=true pnpm --dir documentation run build",
        "docs:integration:check": "pnpm --dir documentation exec eslint tests && tsc --project documentation/tests/tsconfig.json",
        "docs:integration:test": "pnpm run docs:integration:check && playwright test --config documentation/tests/playwright.config.ts",
        "docs:serve": "pnpm --dir packages/tum-ui exec vite preview --outDir ../../documentation/build --host 127.0.0.1 --port 3000 --strictPort",
        "docs:test": "pnpm run docs:build && pnpm run docs:integration:test",
        "docs:test:prepared": "pnpm run docs:build:prepared && pnpm run docs:integration:test",
        "lighthouse": "node supporting_scripts/lighthouse/run-lighthouse.mjs",
        "lint": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint src/main/webapp src/test/javascript && pnpm run tum-ui:lint",
        "lint:fix": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint --fix src/main/webapp src/test/javascript && pnpm run tum-ui:lint:fix",
        "lint:docs": "pnpm -C documentation run lint",
        "lint:playwright": "pnpm -C src/test/playwright run lint",
        "postinstall": "husky",
        "prebuild": "node prebuild.mjs",
        "prepare": "husky",
        "prettier:check": "prettier --check \"src/{main/webapp,test}/**/*.{json,ts,js,css,scss,html}\" \"packages/tum-ui/**/*.{json,ts,js,css,scss,html}\"",
        "prettier:write": "prettier --write \"src/{main/webapp,test}/**/*.{json,ts,js,css,scss,html}\" \"packages/tum-ui/**/*.{json,ts,js,css,scss,html}\"",
        "start": "pnpm run prebuild -- --develop && concurrently --kill-others --names \"tum-ui-styles,artemis\" \"pnpm --dir packages/tum-ui run build:styles -- --development --watch\" \"ng serve --hmr --poll 1000\"",
        "test-diff:ci": "git fetch origin develop && pnpm run prebuild && pnpm run vitest:diff",
        "test-diff": "pnpm run prebuild && pnpm run vitest:diff",
        "test:ci": "pnpm run prebuild && pnpm run vitest:ci && pnpm run vitest:monaco",
        "test": "pnpm run prebuild && pnpm exec vitest run",
        "test:one": "pnpm run prebuild && pnpm exec vitest run",
        "test:rules": "vitest run --config rules/vitest.config.mjs",
        "tum-ui:build": "pnpm --dir packages/tum-ui run build",
        "tum-ui:build:dev": "pnpm --dir packages/tum-ui run build:dev",
        "tum-ui:build:styles": "pnpm --dir packages/tum-ui run build:styles",
        "tum-ui:check:styles": "pnpm --dir packages/tum-ui run check:styles",
        "tum-ui:build:watch": "pnpm --dir packages/tum-ui run build:watch",
        "tum-ui:lint": "pnpm --dir packages/tum-ui run lint",
        "tum-ui:lint:fix": "pnpm --dir packages/tum-ui run lint:fix",
        "tum-ui:pack:check": "pnpm --dir packages/tum-ui run pack:check",
        "tum-ui:source:check": "pnpm run prebuild -- --develop && pnpm run tum-ui:source:check:prepared",
        "tum-ui:source:check:prepared": "ng build artemis --configuration development,tum-ui-source",
        "tum-ui:stylelint": "pnpm --dir packages/tum-ui run stylelint",
        "tum-ui:test": "pnpm --dir packages/tum-ui run test",
        "tum-ui:test:coverage": "pnpm --dir packages/tum-ui run test:coverage",
        "tum-ui:test:watch": "pnpm --dir packages/tum-ui run test:watch",
        "tum-ui:validate": "pnpm run lint && pnpm run compile:tests && pnpm run test:rules && pnpm run tum-ui:stylelint && pnpm run tum-ui:test:coverage && pnpm run tum-ui:pack:check && pnpm run tum-ui:source:check:prepared && pnpm --dir packages/tum-ui run storybook:validate && pnpm run docs:test:prepared",
        "setupCourse": "node supporting_scripts/course-scripts/setup-course/setup-course.mjs",
        "vitest": "vitest",
        "vitest:run": "vitest run",
        "vitest:ci": "cross-env NODE_OPTIONS='--max-old-space-size=8192 --max-semi-space-size=128' pnpm exec vitest run --coverage --maxWorkers=2",
        "vitest:monaco": "cross-env NODE_OPTIONS='--max-old-space-size=8192 --max-semi-space-size=128' pnpm exec vitest run --config vitest.monaco.config.ts --maxWorkers=2",
        "vitest:coverage": "vitest run --coverage",
        "vitest:diff": "vitest run --changed origin/develop --passWithNoTests",
        "vitest:ui": "vitest --ui",
        "sync-versions": "node supporting_scripts/sync-client-versions.mjs",
        "sync-versions:check": "node supporting_scripts/sync-client-versions.mjs --check",
        "sync-versions:reverse": "node supporting_scripts/sync-client-versions.mjs --reverse",
        "update": "ncu -i --format group",
        "webapp:build": "pnpm run clean-www && pnpm run prebuild -- --develop && ng build --configuration development",
        "webapp:prod": "pnpm run clean-www && pnpm run prebuild && cross-env NG_BUILD_OPTIMIZE_CHUNKS=1 ng build --configuration production",
        "sbom:generate-full": "cross-env FETCH_LICENSE=false pnpm dlx @cyclonedx/cdxgen@12.4.0 --type pnpm --output build/reports/client-sbom-full.json --spec-version 1.6 --no-babel --no-recurse --profile generic",
        "sbom:filter-shipped": "node supporting_scripts/sbom-filter-by-bundle.mjs build/reports/client-sbom-full.json build/reports/client-sbom.json build/resources/main/static",
        "sbom:generate": "pnpm run sbom:generate-full && pnpm run sbom:filter-shipped",
        "migrate:status": "node supporting_scripts/migration/migrate.mjs status",
        "migrate:check": "node supporting_scripts/migration/migrate.mjs check"
    }
}
