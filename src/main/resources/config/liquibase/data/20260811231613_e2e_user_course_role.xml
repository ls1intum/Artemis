<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
    logicalFilePath="config/liquibase/changelog/20260811231613_changelog.xml">

    <!--
        Seed data for the end-to-end tests, split out of 20260811231613_changelog.xml when the changelogs it
        sat among were folded into a baseline. It keeps that file's logicalFilePath, so the changeset is the
        same one every database has already recorded and nothing re-runs.

        It has to live here rather than among the folded changelogs: a folded changeset is recorded without
        being executed on a fresh installation, which is correct for a schema change that the baseline
        already contains, and wrong for seed data, whose rows would simply be missing. Everything under
        config/liquibase/data is evaluated on every installation.

        The rows reproduce exactly what the 20260518120000-2 backfill produced before user_groups was
        dropped: 144 rows, 96 STUDENT, 24 TEACHING_ASSISTANT and 24 INSTRUCTOR over the 24 seeded courses.
    -->

    <changeSet id="20260811231613-01-seed-e2e-user-course-role" author="krusche" context="e2e">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM user_course_role WHERE course_id = 9001</sqlCheck>
        </preConditions>
        <loadData file="config/liquibase/e2e/user_course_role.csv" separator=";" tableName="user_course_role" usePreparedStatements="true">
            <column name="user_id" type="NUMERIC"/>
            <column name="course_id" type="NUMERIC"/>
        </loadData>
    </changeSet>
</databaseChangeLog>
