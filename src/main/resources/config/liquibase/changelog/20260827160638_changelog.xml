<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
    The complete schema for the Iris proactive struggle intervention (#350), in one migration.

    Additive and non-destructive: four nullable columns plus an index on the existing iris_message table, and two
    new tables. No drops, no alters of existing columns, no data backfill. Existing iris_message rows get NULL.

    iris_message gains:
      origin                 marks a row as proactive, so it can be excluded from the AI rate limit, included in
                             the chat overview, and rendered differently in the history sent to Pyris
      proactive_outcome      how the episode ended; the first terminal value wins and is never overwritten
      proactive_episode_id   ties the rows of one episode together for the episode-scoped outcome endpoint
      proactive_exercise_id  the exercise the row was decided for, so a client-reused episode id cannot make one
                             exercise's outcome terminal for another

    iris_ambient_decision records the ambient hints Artemis offers, so revealing one does not trust the client.
    The ambient flow is a pull model: Artemis tells the client a hint exists and only writes the chat message when
    the student clicks reveal. Without this table the reveal endpoint took the hint text from the caller, which let
    a student post arbitrary text as an LLM / PROACTIVE_STRUGGLE message. Those rows are replayed to Pyris as
    assistant history, so that was a way to put words in the tutor's mouth, and fresh ids minted unlimited rows.

    Each row is the server's own copy of what it offered. Reveal looks it up by (user_id, exercise_id, episode_id),
    persists hint_text rather than the caller's copy, and claims the row via consumed_at in the same transaction,
    which makes a decision revealable exactly once.

    The unique constraint on (user_id, exercise_id, episode_id) matches the flow's contract of one ambient offer per
    episode and lets a repeated decision callback be recognised instead of duplicating the offer. episode_id is NOT
    NULL on purpose: a decision without an episode cannot be addressed by a reveal, so those are never recorded and
    no nullable column takes part in the uniqueness. Its width matches iris_message.proactive_episode_id, so an id
    that can be recorded can always be persisted on the message too.

    iris_proactive_episode registers each episode when its trigger is accepted, so the episode has a row that can be
    locked and a place to hold its terminal outcome even before its first message exists. Details on the changeSet.

    Every changeSet is precondition-guarded so a partially migrated database still gets the missing pieces.
    -->

    <changeSet id="20260827160638-1-add-origin-mysql" author="liam-berger" dbms="mysql,h2">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="iris_message" columnName="origin"/></not>
        </preConditions>
        <addColumn tableName="iris_message">
            <column name="origin" type="ENUM('PROACTIVE_STRUGGLE')"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260827160638-1-add-origin-postgres" author="liam-berger" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="iris_message" columnName="origin"/></not>
        </preConditions>
        <addColumn tableName="iris_message">
            <column name="origin" type="text"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260827160638-2-add-proactive-outcome-mysql" author="liam-berger" dbms="mysql,h2">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="iris_message" columnName="proactive_outcome"/></not>
        </preConditions>
        <addColumn tableName="iris_message">
            <column name="proactive_outcome" type="ENUM('DISMISSED','RECOVERED','ABANDONED','INTERRUPTED')"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260827160638-2-add-proactive-outcome-postgres" author="liam-berger" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="iris_message" columnName="proactive_outcome"/></not>
        </preConditions>
        <addColumn tableName="iris_message">
            <column name="proactive_outcome" type="text"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260827160638-3-add-proactive-episode-id" author="liam-berger">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="iris_message" columnName="proactive_episode_id"/></not>
        </preConditions>
        <addColumn tableName="iris_message">
            <column name="proactive_episode_id" type="varchar(64)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260827160638-4-create-iris-ambient-decision" author="liam-berger">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="iris_ambient_decision"/></not>
        </preConditions>
        <createTable tableName="iris_ambient_decision">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="exercise_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="episode_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="hint_text" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime(3)">
                <constraints nullable="false"/>
            </column>
            <column name="consumed_at" type="datetime(3)"/>
            <column name="consumed_message_id" type="BIGINT"/>
        </createTable>
        <addUniqueConstraint tableName="iris_ambient_decision" columnNames="user_id, exercise_id, episode_id"
                             constraintName="ux_iris_ambient_decision_user_exercise_episode"/>
        <createIndex tableName="iris_ambient_decision" indexName="idx_iris_ambient_decision_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!--
    Deletion paths. iris_ambient_decision carries user_id and exercise_id as plain columns (deliberately not JPA
    associations: the reveal must not trust a client-supplied hint, so the row is the server's own copy). Without
    foreign keys, deleting a user or an exercise would leave orphaned decisions behind. These cascade the delete,
    matching iris_session, which cascades on the same jhi_user / exercise references. Deleting a course cascades
    through its exercises, so no separate course FK is needed. Split into their own precondition-guarded changesets
    so a database that already created the table (without the keys) still picks them up.
    -->
    <changeSet id="20260827160638-5-add-iris-ambient-decision-user-fk" author="liam-berger">
        <preConditions onFail="MARK_RAN">
            <not><foreignKeyConstraintExists foreignKeyName="fk_iris_ambient_decision_user_id" foreignKeyTableName="iris_ambient_decision"/></not>
        </preConditions>
        <!-- A database that created the table before these keys existed may already hold rows whose user was deleted
             (no FK then enforced it). Adding the constraint would fail validating them. Drop such orphans first; the
             row is only the server's own copy of an offer whose owner no longer exists, so it is safe to delete. On a
             fresh install this matches nothing. -->
        <delete tableName="iris_ambient_decision">
            <where>NOT EXISTS (SELECT 1 FROM jhi_user u WHERE u.id = user_id)</where>
        </delete>
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="iris_ambient_decision" constraintName="fk_iris_ambient_decision_user_id"
                                 referencedColumnNames="id" referencedTableName="jhi_user" onDelete="CASCADE" onUpdate="RESTRICT"/>
    </changeSet>

    <changeSet id="20260827160638-6-add-iris-ambient-decision-exercise-fk" author="liam-berger">
        <preConditions onFail="MARK_RAN">
            <not><foreignKeyConstraintExists foreignKeyName="fk_iris_ambient_decision_exercise_id" foreignKeyTableName="iris_ambient_decision"/></not>
        </preConditions>
        <!-- Same guard for the exercise reference: drop rows whose exercise was already deleted before this FK. -->
        <delete tableName="iris_ambient_decision">
            <where>NOT EXISTS (SELECT 1 FROM exercise e WHERE e.id = exercise_id)</where>
        </delete>
        <addForeignKeyConstraint baseColumnNames="exercise_id" baseTableName="iris_ambient_decision" constraintName="fk_iris_ambient_decision_exercise_id"
                                 referencedColumnNames="id" referencedTableName="exercise" onDelete="CASCADE" onUpdate="RESTRICT"/>
    </changeSet>

    <!--
    Binds a proactive message to the exercise it was decided for.

    proactive_episode_id alone does not identify an episode: the id is client-generated, so the same id can be sent
    for two different exercises. Scoped only by the owning user, which closes the IDOR, one exercise's terminal
    outcome then marked the other exercise's episode as finished.

    The exercise cannot be derived from the session. iris_session.entity_id and chat_mode change on every context
    switch (a session is born a COURSE_CHAT and is switched to an exercise later), so the session records where the
    chat points NOW, not which exercise a historical row belongs to. The binding therefore lives on the message row,
    written once at insert time and never updated.
    -->
    <changeSet id="20260827160638-7-add-proactive-exercise-id" author="liam-berger">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="iris_message" columnName="proactive_exercise_id"/></not>
        </preConditions>
        <addColumn tableName="iris_message">
            <column name="proactive_exercise_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <!--
    Every episode lookup filters on (proactive_episode_id, proactive_exercise_id) and one of them additionally on
    proactive_outcome, so the composite index covers the whole predicate. Separate changeSet so a database that
    already has the column still picks the index up.
    -->
    <changeSet id="20260827160638-8-index-proactive-episode-exercise" author="liam-berger">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="iris_message" indexName="idx_iris_message_proactive_episode_exercise"/></not>
        </preConditions>
        <createIndex tableName="iris_message" indexName="idx_iris_message_proactive_episode_exercise">
            <column name="proactive_episode_id"/>
            <column name="proactive_exercise_id"/>
        </createIndex>
    </changeSet>

    <!--
    The episode as a row of its own, so it has an identity that can be locked.

    Every terminal decision used to be a check-then-act: a callback read whether the episode was already closed and
    wrote its message in a separate statement, so a dismiss committing in between produced a hint the student had
    already dismissed. There was nothing to serialize on. The chat session cannot serve as the mutex, because a
    session is resolved as "the latest for (user, exercise)" with no uniqueness constraint, so an episode's existing
    message and its next append can sit in different sessions and take different locks. The episode could not lock
    itself either, since before its first message row it had no row at all.

    A row is written when Artemis accepts a trigger, which is also what makes an outcome arriving before the first
    message representable instead of deferred. outcome is the authoritative terminal state;
    iris_message.proactive_outcome stays as a subordinate mirror for the history replayed to Pyris.

    The unique key mirrors iris_ambient_decision: the same natural key, and NOT NULL on every column that takes part
    in it. created_at is indexed for the retention of episodes whose callback never arrived. The foreign keys
    cascade for the same reason as there, so an episode never outlives its user or its exercise; a deleted course
    cascades through its exercises.
    -->
    <changeSet id="20260827160638-9-create-iris-proactive-episode" author="liam-berger">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="iris_proactive_episode"/></not>
        </preConditions>
        <createTable tableName="iris_proactive_episode">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="exercise_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="episode_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="outcome" type="varchar(32)"/>
            <column name="created_at" type="datetime(3)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!--
    The key and the index are their own changesets on purpose. Guarding them with the table's tableExists
    precondition would mark them as run on a database that somehow holds a partial table, and the uniqueness this
    design depends on would silently not exist.
    -->
    <changeSet id="20260827160638-10-add-iris-proactive-episode-unique-key" author="liam-berger">
        <preConditions onFail="MARK_RAN">
            <not><uniqueConstraintExists tableName="iris_proactive_episode" constraintName="ux_iris_proactive_episode_user_exercise_episode"/></not>
        </preConditions>
        <addUniqueConstraint tableName="iris_proactive_episode" columnNames="user_id, exercise_id, episode_id"
                             constraintName="ux_iris_proactive_episode_user_exercise_episode"/>
    </changeSet>

    <changeSet id="20260827160638-11-index-iris-proactive-episode-created-at" author="liam-berger">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="iris_proactive_episode" indexName="idx_iris_proactive_episode_created_at"/></not>
        </preConditions>
        <createIndex tableName="iris_proactive_episode" indexName="idx_iris_proactive_episode_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260827160638-12-add-iris-proactive-episode-user-fk" author="liam-berger">
        <preConditions onFail="MARK_RAN">
            <not><foreignKeyConstraintExists foreignKeyName="fk_iris_proactive_episode_user_id" foreignKeyTableName="iris_proactive_episode"/></not>
        </preConditions>
        <delete tableName="iris_proactive_episode">
            <where>NOT EXISTS (SELECT 1 FROM jhi_user u WHERE u.id = user_id)</where>
        </delete>
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="iris_proactive_episode" constraintName="fk_iris_proactive_episode_user_id"
                                 referencedColumnNames="id" referencedTableName="jhi_user" onDelete="CASCADE" onUpdate="RESTRICT"/>
    </changeSet>

    <changeSet id="20260827160638-13-add-iris-proactive-episode-exercise-fk" author="liam-berger">
        <preConditions onFail="MARK_RAN">
            <not><foreignKeyConstraintExists foreignKeyName="fk_iris_proactive_episode_exercise_id" foreignKeyTableName="iris_proactive_episode"/></not>
        </preConditions>
        <delete tableName="iris_proactive_episode">
            <where>NOT EXISTS (SELECT 1 FROM exercise e WHERE e.id = exercise_id)</where>
        </delete>
        <addForeignKeyConstraint baseColumnNames="exercise_id" baseTableName="iris_proactive_episode" constraintName="fk_iris_proactive_episode_exercise_id"
                                 referencedColumnNames="id" referencedTableName="exercise" onDelete="CASCADE" onUpdate="RESTRICT"/>
    </changeSet>

</databaseChangeLog>
