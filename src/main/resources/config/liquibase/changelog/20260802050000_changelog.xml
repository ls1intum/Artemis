<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Delete existing keys before adding unique constraint on key id -->
    <changeSet id="20260802050000-1a" author="angatha and Lion Holtkötter" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <uniqueConstraintExists tableName="jhi_user" constraintName="jhu_user_reset_key_id" />
            </not>
        </preConditions>

        <sql>
            UPDATE jhi_user
            SET reset_key_id   = NULL,
                reset_key_hash = NULL
            WHERE reset_key_id IN (SELECT reset_key_id
                                   FROM jhi_user
                                   WHERE reset_key_id IS NOT NULL
                                   GROUP BY reset_key_id
                                   HAVING COUNT(*) > 1);
        </sql>

        <addUniqueConstraint tableName="jhi_user" columnNames="reset_key_id" constraintName="jhu_user_reset_key_id" />
    </changeSet>
    <changeSet id="20260802050000-1b" author="angatha and Lion Holtkötter" dbms="mysql">
        <preConditions onFail="MARK_RAN">
            <not>
                <uniqueConstraintExists tableName="jhi_user" constraintName="jhu_user_reset_key_id" />
            </not>
        </preConditions>

        <sql>
            UPDATE jhi_user u1
                JOIN (
                    SELECT reset_key_id
                    FROM jhi_user
                    WHERE reset_key_id IS NOT NULL
                    GROUP BY reset_key_id
                    HAVING COUNT(*) > 1
                ) u2 ON u1.reset_key_id = u2.reset_key_id
            SET u1.reset_key_id = NULL,
                u1.reset_key_hash = NULL;
        </sql>

        <addUniqueConstraint tableName="jhi_user" columnNames="reset_key_id" constraintName="jhu_user_reset_key_id" />
    </changeSet>
    <changeSet id="20260802050000-1b" author="angatha and Lion Holtkötter" dbms="!postgres, !mysql">
        <preConditions onFail="MARK_RAN">
            <not>
                <uniqueConstraintExists tableName="jhi_user" constraintName="jhu_user_reset_key_id" />
            </not>
        </preConditions>

        <sql>
            UPDATE jhi_user
            SET reset_key_id   = NULL,
                reset_key_hash = NULL
        </sql>

        <addUniqueConstraint tableName="jhi_user" columnNames="reset_key_id" constraintName="jhu_user_reset_key_id" />
    </changeSet>
</databaseChangeLog>
