<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Consolidated struggle-intervention schema for iris_message (#350). Single migration for the whole
         feature; the proactive_outcome enum already includes INTERRUPTED. Each column/dbms is a separate,
         precondition-guarded changeSet so a partial schema still recreates the missing pieces. -->

    <changeSet id="20260614120000-1-add-origin-mysql" author="liam-berger" dbms="mysql,h2">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="iris_message" columnName="origin"/></not>
        </preConditions>
        <addColumn tableName="iris_message">
            <column name="origin" type="ENUM('PROACTIVE_STRUGGLE')"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260614120000-1-add-origin-postgres" author="liam-berger" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="iris_message" columnName="origin"/></not>
        </preConditions>
        <addColumn tableName="iris_message">
            <column name="origin" type="text"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260614120000-2-add-proactive-outcome-mysql" author="liam-berger" dbms="mysql,h2">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="iris_message" columnName="proactive_outcome"/></not>
        </preConditions>
        <addColumn tableName="iris_message">
            <column name="proactive_outcome" type="ENUM('DISMISSED','RECOVERED','ABANDONED','INTERRUPTED')"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260614120000-2-add-proactive-outcome-postgres" author="liam-berger" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="iris_message" columnName="proactive_outcome"/></not>
        </preConditions>
        <addColumn tableName="iris_message">
            <column name="proactive_outcome" type="text"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260614120000-3-add-proactive-episode-id" author="liam-berger">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="iris_message" columnName="proactive_episode_id"/></not>
        </preConditions>
        <addColumn tableName="iris_message">
            <column name="proactive_episode_id" type="varchar(64)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
