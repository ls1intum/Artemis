<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
    Enforce "a student may belong to at most one team per exercise" in the schema.

    The invariant spans two tables (exercise_id lives on team, not team_student), so it cannot be
    expressed as a plain unique index. Production historically enforced it with a BEFORE INSERT
    trigger that was dropped from the changelogs by ed4696bcb3 (PostgreSQL support). That trigger is
    NOT race-safe: its lookup is a non-locking snapshot read, so two concurrent transactions both
    pass and both commit.

    Instead we denormalise exercise_id onto team_student and let a real unique index enforce the
    invariant. A BEFORE INSERT trigger populates the column, which is permitted because modifying
    NEW.* on the trigger's own table is not a prohibited self-update. Hibernate keeps inserting only
    (team_id, student_id), so the @ManyToMany @JoinTable mapping on Team.students is unchanged. A
    second trigger propagates team.exercise_id to the derived column when a team is moved, so the
    column cannot go stale and quietly stop expressing the invariant.

    The order of the changesets below matters and must not be rearranged: the triggers are installed
    directly after the nullable column, before the backfill and the constraints. Artemis nodes
    running the previous version keep inserting only (team_id, student_id) while the migration runs,
    so any such insert landing after the NOT NULL constraint but before the trigger would fail, and
    one landing between the backfill and the NOT NULL constraint would fail the migration itself.
    -->

    <changeSet id="20260728221528-1-add-exercise-id-to-team-student" author="krusche">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="team_student" columnName="exercise_id"/></not>
        </preConditions>
        <addColumn tableName="team_student">
            <column name="exercise_id" type="bigint"/>
        </addColumn>
    </changeSet>

    <!-- Keep exercise_id populated for inserts issued by Hibernate, which only writes two columns.
         splitStatements=false is required: the body contains semicolons. Note there is deliberately
         no DELIMITER directive - that is a mysql client feature and is invalid over JDBC. -->
    <changeSet id="20260728221528-2-set-exercise-id-trigger-mysql" author="krusche" dbms="mysql">
        <sql splitStatements="false"><![CDATA[
CREATE TRIGGER team_student_set_exercise_id
BEFORE INSERT ON team_student
FOR EACH ROW
BEGIN
    IF NEW.exercise_id IS NULL THEN
        SET NEW.exercise_id = (SELECT t.exercise_id FROM team t WHERE t.id = NEW.team_id);
    END IF;
END
        ]]></sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS team_student_set_exercise_id</sql>
        </rollback>
    </changeSet>

    <changeSet id="20260728221528-3-set-exercise-id-function-postgresql" author="krusche" dbms="postgresql">
        <sql splitStatements="false"><![CDATA[
CREATE OR REPLACE FUNCTION team_student_set_exercise_id() RETURNS TRIGGER AS $$
DECLARE
    v_exercise_id BIGINT;
BEGIN
    IF NEW.exercise_id IS NULL THEN
        SELECT t.exercise_id INTO v_exercise_id FROM team t WHERE t.id = NEW.team_id;
        NEW.exercise_id := v_exercise_id;
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql
        ]]></sql>
        <rollback>
            <sql>DROP FUNCTION IF EXISTS team_student_set_exercise_id()</sql>
        </rollback>
    </changeSet>

    <changeSet id="20260728221528-4-set-exercise-id-trigger-postgresql" author="krusche" dbms="postgresql">
        <sql splitStatements="false"><![CDATA[
CREATE TRIGGER team_student_set_exercise_id
BEFORE INSERT ON team_student
FOR EACH ROW EXECUTE FUNCTION team_student_set_exercise_id()
        ]]></sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS team_student_set_exercise_id ON team_student</sql>
        </rollback>
    </changeSet>

    <!-- Keep exercise_id in sync when a team is moved to another exercise. Without this the denormalised
         column would keep the old exercise, which both hides a real conflict in the target exercise and
         frees the slot in the source exercise, so the unique index below would no longer express the
         invariant. TeamResource.updateTeam currently rejects a change of exercise, so this does not fire
         today; it exists so the derived column stays correct if that ever becomes possible, rather than
         silently degrading the guarantee. A move that would collide with an existing team in the target
         exercise fails on the unique index, which is the intended outcome.
         The trigger is on team and writes team_student, so it is not a prohibited self-update. -->
    <changeSet id="20260728221528-4a-sync-exercise-id-trigger-mysql" author="krusche" dbms="mysql">
        <sql splitStatements="false"><![CDATA[
CREATE TRIGGER team_student_sync_exercise_id
AFTER UPDATE ON team
FOR EACH ROW
BEGIN
    IF NOT (NEW.exercise_id <=> OLD.exercise_id) THEN
        UPDATE team_student SET exercise_id = NEW.exercise_id WHERE team_id = NEW.id;
    END IF;
END
        ]]></sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS team_student_sync_exercise_id</sql>
        </rollback>
    </changeSet>

    <changeSet id="20260728221528-4b-sync-exercise-id-function-postgresql" author="krusche" dbms="postgresql">
        <sql splitStatements="false"><![CDATA[
CREATE OR REPLACE FUNCTION team_student_sync_exercise_id() RETURNS TRIGGER AS $$
BEGIN
    IF NEW.exercise_id IS DISTINCT FROM OLD.exercise_id THEN
        UPDATE team_student SET exercise_id = NEW.exercise_id WHERE team_id = NEW.id;
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql
        ]]></sql>
        <rollback>
            <sql>DROP FUNCTION IF EXISTS team_student_sync_exercise_id()</sql>
        </rollback>
    </changeSet>

    <changeSet id="20260728221528-4c-sync-exercise-id-trigger-postgresql" author="krusche" dbms="postgresql">
        <sql splitStatements="false"><![CDATA[
CREATE TRIGGER team_student_sync_exercise_id
AFTER UPDATE ON team
FOR EACH ROW EXECUTE FUNCTION team_student_sync_exercise_id()
        ]]></sql>
        <rollback>
            <sql>DROP TRIGGER IF EXISTS team_student_sync_exercise_id ON team</sql>
        </rollback>
    </changeSet>

    <!-- Correlated subquery form works identically on MySQL and PostgreSQL. -->
    <changeSet id="20260728221528-5-backfill-exercise-id" author="krusche">
        <update tableName="team_student">
            <column name="exercise_id"
                    valueComputed="(SELECT t.exercise_id FROM team t WHERE t.id = team_student.team_id)"/>
            <where>exercise_id IS NULL</where>
        </update>
        <!-- UpdateDataChange has no automatic inverse; rolling back changeset -1 drops the column
             and with it the backfilled data, so an empty rollback is correct here. -->
        <rollback/>
    </changeSet>

    <!-- MySQL and H2 keep the portable form. InnoDB runs both as online DDL, so they do not block
         readers and writers the way the PostgreSQL equivalents would. -->
    <changeSet id="20260728221528-6-exercise-id-not-null" author="krusche" dbms="!postgresql">
        <addNotNullConstraint tableName="team_student" columnName="exercise_id" columnDataType="bigint"/>
    </changeSet>

    <!-- PostgreSQL takes an ACCESS EXCLUSIVE lock for the whole table scan of a plain SET NOT NULL, which
         blocks reads and writes from the other nodes for the duration of a rolling deployment. Adding the
         equivalent CHECK as NOT VALID takes that lock only briefly, validating it afterwards needs just
         SHARE UPDATE EXCLUSIVE, and a validated CHECK then lets SET NOT NULL skip the scan entirely. -->
    <changeSet id="20260728221528-6a-exercise-id-not-null-check-postgresql" author="krusche" dbms="postgresql">
        <sql>ALTER TABLE team_student ADD CONSTRAINT team_student_exercise_id_not_null CHECK (exercise_id IS NOT NULL) NOT VALID</sql>
        <rollback>
            <sql>ALTER TABLE team_student DROP CONSTRAINT IF EXISTS team_student_exercise_id_not_null</sql>
        </rollback>
    </changeSet>

    <changeSet id="20260728221528-6b-validate-exercise-id-check-postgresql" author="krusche" dbms="postgresql">
        <sql>ALTER TABLE team_student VALIDATE CONSTRAINT team_student_exercise_id_not_null</sql>
        <!-- Validation only flips a catalog flag; changeset 6a owns dropping the constraint again. -->
        <rollback/>
    </changeSet>

    <changeSet id="20260728221528-6c-exercise-id-not-null-postgresql" author="krusche" dbms="postgresql">
        <sql>ALTER TABLE team_student ALTER COLUMN exercise_id SET NOT NULL</sql>
        <!-- The CHECK has served its purpose once the column itself is NOT NULL. -->
        <sql>ALTER TABLE team_student DROP CONSTRAINT team_student_exercise_id_not_null</sql>
        <rollback>
            <sql>ALTER TABLE team_student ALTER COLUMN exercise_id DROP NOT NULL</sql>
        </rollback>
    </changeSet>

    <!-- The actual guarantee. Fails loudly if any installation already violates the invariant. -->
    <changeSet id="20260728221528-7-unique-exercise-student" author="krusche" dbms="!postgresql">
        <addUniqueConstraint tableName="team_student" columnNames="exercise_id, student_id"
                             constraintName="uk_team_student_exercise_student"/>
    </changeSet>

    <!-- Same reasoning on PostgreSQL: building the unique index through ADD CONSTRAINT holds ACCESS
         EXCLUSIVE for the whole build. CONCURRENTLY builds it without blocking writers, which cannot run
         inside a transaction, hence runInTransaction="false". Attaching the finished index afterwards is a
         catalog-only operation. A failed concurrent build leaves an invalid index behind, so the build is
         idempotent and the rollback drops it either way. -->
    <changeSet id="20260728221528-7a-unique-index-concurrently-postgresql" author="krusche" dbms="postgresql" runInTransaction="false">
        <sql>CREATE UNIQUE INDEX CONCURRENTLY IF NOT EXISTS uk_team_student_exercise_student ON team_student (exercise_id, student_id)</sql>
        <rollback>
            <sql>DROP INDEX IF EXISTS uk_team_student_exercise_student</sql>
        </rollback>
    </changeSet>

    <changeSet id="20260728221528-7b-attach-unique-constraint-postgresql" author="krusche" dbms="postgresql">
        <sql>ALTER TABLE team_student ADD CONSTRAINT uk_team_student_exercise_student UNIQUE USING INDEX uk_team_student_exercise_student</sql>
        <rollback>
            <sql>ALTER TABLE team_student DROP CONSTRAINT IF EXISTS uk_team_student_exercise_student</sql>
        </rollback>
    </changeSet>

    <!-- The legacy advisory trigger is now redundant: the unique index enforces the invariant
         properly. Only ever existed on long-lived MySQL installations. -->
    <changeSet id="20260728221528-8-drop-legacy-team-student-trigger" author="krusche" dbms="mysql">
        <sql>DROP TRIGGER IF EXISTS uc_team_student_exercise_id_and_student_id</sql>
        <!-- RawSQLChange has no automatic inverse. Restore the legacy trigger so a rollback really
             returns to the previous state. Note it is only advisory (a non-locking snapshot read),
             which is why the unique index above replaces it. -->
        <rollback>
            <sql splitStatements="false"><![CDATA[
CREATE TRIGGER uc_team_student_exercise_id_and_student_id
BEFORE INSERT ON team_student
FOR EACH ROW
BEGIN
    DECLARE v_exercise_id BIGINT;
    DECLARE v_conflict_team_id BIGINT;
    SELECT t.exercise_id INTO v_exercise_id FROM team t WHERE t.id = NEW.team_id;
    SELECT ts.team_id INTO v_conflict_team_id
    FROM team t JOIN team_student ts ON ts.team_id = t.id
    WHERE t.exercise_id = v_exercise_id AND ts.team_id <> NEW.team_id AND ts.student_id = NEW.student_id
    LIMIT 1;
    IF v_conflict_team_id IS NOT NULL THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Student is already part of another team for this exercise';
    END IF;
END
            ]]></sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
