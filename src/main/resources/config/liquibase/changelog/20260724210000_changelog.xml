<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Remove jhi_user.reset_key and replace it with two columns for id and hash -->
    <changeSet id="20260724210000-1" author="angatha and Lion Holtkötter">
        <renameColumn tableName="jhi_user" oldColumnName="reset_key" newColumnName="reset_key_id"/>
        <update tableName="jhi_user">
            <column name="reset_key_id" value="null"/>
        </update>
        <addColumn tableName="jhi_user">
            <column name="reset_key_hash" type="varchar(255)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
