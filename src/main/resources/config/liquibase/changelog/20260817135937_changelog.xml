<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
    Covering index for the statement that dominated the production slow query log.

    The active user metrics (StatisticsRepository#findLastSubmissionPerActiveUser) scan a 30 day window of submissions
    and only need the participation of each row. With the existing single column index on submission_date every
    matching row still had to be read from the clustered index; the composite index turns that into an index-only
    range scan ("Covering index range scan" in EXPLAIN ANALYZE).

    Measured on a production dump over a 30 day window (419k submissions, 3483 active users), warm buffer pool:
    the replaced aggregation took 6.71s, the rewritten query 0.51s with the indexes that exist today, and 0.34s with
    this index.

    The pre-existing index on submission(submission_date) becomes a redundant leftmost prefix of the new index and is
    dropped, so that INSERTs into the largest table of the schema do not maintain both.

    Note for deployment: creating an index on submission touches every row of the largest table in the schema (~17
    million rows in production). MySQL builds it in place and allows concurrent DML, but the migration takes a few
    minutes and Liquibase runs it during startup.
    -->

    <changeSet id="20260817-01-add-submission-date-participation-index" author="krusche">
        <createIndex indexName="idx_submission_date_participation" tableName="submission">
            <column name="submission_date"/>
            <column name="participation_id"/>
        </createIndex>
    </changeSet>

    <!-- The single column index is a leftmost prefix of the composite one created above and therefore redundant -->
    <changeSet id="20260817-02-drop-redundant-submission-date-index" author="krusche">
        <preConditions onFail="MARK_RAN">
            <indexExists tableName="submission" indexName="submission_date"/>
        </preConditions>
        <dropIndex indexName="submission_date" tableName="submission"/>
    </changeSet>

    <!--
    Covering index for the in-time submission counts on the course and exam assessment dashboards
    (SubmissionRepository#countAllByExerciseIdsSubmittedBeforeDueDate and its exam variant). They walk the
    participations of a course and read discriminator, submitted and submission_date of each participation's
    submissions. The existing index on (participation_id, submission_date) cannot answer that, so every candidate row
    was fetched from the clustered index.

    Measured on a production dump for a course with 89 exercises: 0.42s -> 0.32s warm, and EXPLAIN ANALYZE turns
    227,789 index lookups with ~391k row fetches into "Covering index lookup" with none. Those fetches are what makes
    the statement take 7.4s on production, where the working set does not fit into the buffer pool.
    -->
    <changeSet id="20260817-03-add-submission-participation-covering-index" author="krusche">
        <createIndex indexName="idx_submission_participation_type_submitted_date" tableName="submission">
            <column name="participation_id"/>
            <column name="discriminator"/>
            <column name="submitted"/>
            <column name="submission_date"/>
        </createIndex>
    </changeSet>

    <!--
    Denormalize complaint.exercise_id, following the established result.exercise_id precedent.

    The complaint counts on the course and exam assessment dashboards filter a set of exercise ids. Reaching the
    exercise through result made them scan every complaint in the system: on production one course dashboard examined
    all 25,646 complaints to find its 43. Only ~27k rows, so the backfill is quick.
    -->

    <changeSet id="20260817-04-add-complaint-exercise-id" author="krusche">
        <addColumn tableName="complaint">
            <column name="exercise_id" type="bigint"/>
        </addColumn>
    </changeSet>

    <!-- A correlated subquery rather than UPDATE ... JOIN, which MySQL and PostgreSQL spell differently -->
    <changeSet id="20260817-05-backfill-complaint-exercise-id" author="krusche">
        <sql>
            UPDATE complaint c
            SET exercise_id = (SELECT r.exercise_id FROM result r WHERE r.id = c.result_id)
            WHERE c.result_id IS NOT NULL
              AND c.exercise_id IS NULL;
        </sql>
        <rollback/>
    </changeSet>

    <changeSet id="20260817-06-add-complaint-exercise-type-index" author="krusche">
        <createIndex indexName="idx_complaint_exercise_type" tableName="complaint">
            <column name="exercise_id"/>
            <column name="complaint_type"/>
        </createIndex>
    </changeSet>

    <!--
    result_id is nullable, so a complaint without a result would keep a NULL exercise_id and the entity maps the
    column to a primitive. There is no such row on production, and 0 is a sentinel that matches no exercise, so those
    complaints simply stay uncounted instead of blocking the migration.
    -->
    <changeSet id="20260817-07-complaint-exercise-id-not-null" author="krusche">
        <addNotNullConstraint tableName="complaint" columnName="exercise_id" columnDataType="bigint" defaultNullValue="0"/>
    </changeSet>

</databaseChangeLog>
