    <!--
      ==========================================================================================================================================================================
      Cleanup (DESTRUCTIVE, irreversible). Every drag-and-drop / short-answer / multiple-choice question, submission and question-statistic has now been backfilled into the JSON
      columns above, so the legacy relational child tables and the now-unused quiz_statistic_counter columns/rows are removed. This drops the source data, so it must only run
      after the backfills above are trusted (validate on a staging copy first, especially on MySQL — see documentation/docs/developer/guidelines/quiz-json-persistence-migration.mdx).
      quiz_statistic and quiz_statistic_counter themselves are intentionally KEPT: the QuizPointStatistic rows (quiz_statistic discriminator 'QP') and their PointCounter rows
      (quiz_statistic_counter discriminator 'PC', columns points + quiz_point_statistic_id) are still relational. Only the per-question-type counter rows ('DD' / 'SA' / 'AC') and
      their columns are removed.
      ==========================================================================================================================================================================
    -->

    <!-- Step 15: delete the folded statistics counter rows. Their data now lives in quiz_statistic.counters; these discriminators ('DD' drag-and-drop, 'SA' short-answer,
         'AC' multiple-choice answer) no longer map to a JPA entity (those counters are plain JSON POJOs now), so the rows must be removed before their columns are dropped. Only
         'PC' (point) counters remain in quiz_statistic_counter. -->
    <changeSet id="20260707080319-15" author="krusche">
        <sql>
            DELETE FROM quiz_statistic_counter WHERE discriminator IN ('DD', 'SA', 'AC');
        </sql>
    </changeSet>

    <!-- Step 16: drop the now-unused quiz_statistic_counter foreign keys, their backing indexes and the folded counter columns. The drop_location_id / spot_id / answer_id foreign
         keys and unique indexes were already dropped in steps 4 / 7 / 11. points and quiz_point_statistic_id are kept for PointCounter. -->
    <changeSet id="20260707080319-16a" author="krusche">
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists foreignKeyName="FK11jgyics37wyibhhpp866exa8"/>
        </preConditions>
        <dropForeignKeyConstraint baseTableName="quiz_statistic_counter" constraintName="FK11jgyics37wyibhhpp866exa8"/>
    </changeSet>
    <changeSet id="20260707080319-16b" author="krusche">
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists foreignKeyName="FKhascwjyvee25c0k3tay04ghog"/>
        </preConditions>
        <dropForeignKeyConstraint baseTableName="quiz_statistic_counter" constraintName="FKhascwjyvee25c0k3tay04ghog"/>
    </changeSet>
