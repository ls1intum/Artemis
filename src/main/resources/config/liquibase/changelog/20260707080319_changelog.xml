    <!-- Step 10b: backfill quiz_statistic.counters for short-answer question statistics (MySQL) -->
    <changeSet id="20260707080319-10b" author="krusche" dbms="mysql">
        <sql>
            UPDATE quiz_statistic qs
            SET counters = COALESCE((
                SELECT JSON_ARRAYAGG(JSON_OBJECT('spotId', c.spot_id, 'ratedCounter', COALESCE(c.rated_counter, 0), 'unRatedCounter', COALESCE(c.un_rated_counter, 0)))
