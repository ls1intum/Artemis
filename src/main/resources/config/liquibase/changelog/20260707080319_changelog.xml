    <!--
      Quiz JSON persistence, iteration 3 (Multiple-Choice). Reuses the columns added above (quiz_question.content, submitted_answer.selection, quiz_statistic.counters).
      Folds a multiple-choice question's answer options into quiz_question.content, a submission's selected options into submitted_answer.selection, and the per-answer statistics
      counters into quiz_statistic.counters. The old table (answer_option) and the join table (multiple_choice_submitted_answer_selected_options) are dropped in the cleanup section
      at the end of this changelog (step 17). Existing component ids are preserved verbatim (they become the question-scoped ids inside the JSON).
    -->

    <!-- Step 11: drop the answer counter's foreign key and unique index. Multiple-choice answer counters now reference the answer option by its question-scoped id (unique only
         within a question), which no longer maps to a global answer_option row, so neither the FK to answer_option nor the table-wide uniqueness of answer_id can hold. -->
    <changeSet id="20260707080319-11a" author="krusche">
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists foreignKeyName="FKg7hjug3wu6icklf6gbiqs4n18"/>
        </preConditions>
        <dropForeignKeyConstraint baseTableName="quiz_statistic_counter" constraintName="FKg7hjug3wu6icklf6gbiqs4n18"/>
    </changeSet>
    <changeSet id="20260707080319-11b" author="krusche">
        <preConditions onFail="MARK_RAN">
            <indexExists indexName="UC_STATISTIC_COUNTERANSWER_ID_COL"/>
        </preConditions>
        <dropIndex tableName="quiz_statistic_counter" indexName="UC_STATISTIC_COUNTERANSWER_ID_COL"/>
    </changeSet>

    <!-- Step 12a: backfill quiz_question.content for multiple-choice questions (PostgreSQL) -->
    <changeSet id="20260707080319-12a" author="krusche" dbms="postgresql">
        <sql>
            UPDATE quiz_question q
            SET content = jsonb_build_object(
                'type', 'multiple-choice',
                'answerOptions', COALESCE((
                    SELECT jsonb_agg(jsonb_build_object('id', o.id, 'text', o.text, 'hint', o.hint, 'explanation', o.explanation, 'isCorrect', o.is_correct, 'invalid', COALESCE(o.invalid, false))
                        ORDER BY o.answer_options_order)
                    FROM answer_option o WHERE o.question_id = q.id), '[]'::jsonb))
            WHERE q.discriminator = 'MC';
        </sql>
    </changeSet>

    <!-- Step 12b: backfill quiz_question.content for multiple-choice questions (MySQL). CAVEAT: MySQL JSON_ARRAYAGG does not support ORDER BY and does not guarantee element order,
         so the authored answer-option display order (answer_options_order) may not be preserved on MySQL. Scoring is unaffected (options are matched by id), and questions with
         randomizeOrder shuffle client-side anyway; only the display order of a non-randomized question can change. PostgreSQL (step 12a) preserves the order via ORDER BY. Booleans
         are emitted as 0/1 by "= TRUE" and coerced back to Boolean by Jackson on read. -->
    <changeSet id="20260707080319-12b" author="krusche" dbms="mysql">
        <sql>
            UPDATE quiz_question q
            SET content = JSON_OBJECT(
                'type', 'multiple-choice',
                'answerOptions', COALESCE((
                    SELECT JSON_ARRAYAGG(JSON_OBJECT('id', o.id, 'text', o.text, 'hint', o.hint, 'explanation', o.explanation, 'isCorrect', o.is_correct = TRUE, 'invalid', o.invalid = TRUE))
                    FROM answer_option o WHERE o.question_id = q.id), JSON_ARRAY()))
            WHERE q.discriminator = 'MC';
        </sql>
    </changeSet>

    <!-- Step 13a: backfill submitted_answer.selection for multiple-choice submitted answers (PostgreSQL) -->
    <changeSet id="20260707080319-13a" author="krusche" dbms="postgresql">
        <sql>
            UPDATE submitted_answer sa
            SET selection = jsonb_build_object(
                'type', 'mc',
                'soIds', COALESCE((
                    SELECT jsonb_agg(j.selected_options_id)
                    FROM multiple_choice_submitted_answer_selected_options j WHERE j.multiple_choice_submitted_answers_id = sa.id), '[]'::jsonb))
            WHERE sa.discriminator = 'MC';
        </sql>
    </changeSet>

