    <!-- Step 14a: backfill quiz_statistic.counters for multiple-choice question statistics (PostgreSQL) -->
    <changeSet id="20260707080319-14a" author="krusche" dbms="postgresql">
        <sql>
            UPDATE quiz_statistic qs
            SET counters = COALESCE((
                SELECT jsonb_agg(jsonb_build_object('answerId', c.answer_id, 'ratedCounter', COALESCE(c.rated_counter, 0), 'unRatedCounter', COALESCE(c.un_rated_counter, 0)))
                FROM quiz_statistic_counter c WHERE c.multiple_choice_question_statistic_id = qs.id), '[]'::jsonb)
            WHERE qs.discriminator = 'MC';
        </sql>
    </changeSet>

    <!-- Step 14b: backfill quiz_statistic.counters for multiple-choice question statistics (MySQL) -->
    <changeSet id="20260707080319-14b" author="krusche" dbms="mysql">
        <sql>
            UPDATE quiz_statistic qs
            SET counters = COALESCE((
                SELECT JSON_ARRAYAGG(JSON_OBJECT('answerId', c.answer_id, 'ratedCounter', COALESCE(c.rated_counter, 0), 'unRatedCounter', COALESCE(c.un_rated_counter, 0)))
