<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Quiz JSON persistence, iteration 1 (Drag-and-Drop).
      Folds a drag-and-drop question's drop locations / drag items / correct mappings into a JSON column (quiz_question.content), and a submission's mappings into a JSON column
      (submitted_answer.selection), replacing the eager @OneToMany child tables. The old tables (drop_location, drag_item, drag_and_drop_mapping) are dropped in the cleanup section
      at the end of this changelog (step 17), after every question type has been backfilled.
      Existing component ids are preserved verbatim (they become the question-scoped ids inside the JSON), so existing submissions and statistics counters keep resolving.
    -->

    <!-- Step 1a: add the JSON columns (MySQL / H2).
         H2 intentionally gets the columns but no backfill (the backfill changesets below target only mysql/postgresql): H2 is used exclusively as a fresh, per-test database seeded
         through the new JPA POJOs, so there is never any legacy relational quiz data on H2 to migrate. Do not add H2 to the backfill without also giving it the missing
         dialect-specific ordering/boolean handling the mysql/postgresql branches have. -->
    <changeSet id="20260707080319-1a" author="krusche" dbms="mysql,h2">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="quiz_question" columnName="content"/>
            </not>
        </preConditions>
        <addColumn tableName="quiz_question">
            <column name="content" type="json"/>
        </addColumn>
    </changeSet>
    <changeSet id="20260707080319-1b" author="krusche" dbms="mysql,h2">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="submitted_answer" columnName="selection"/>
            </not>
        </preConditions>
        <addColumn tableName="submitted_answer">
            <column name="selection" type="json"/>
        </addColumn>
    </changeSet>

    <!-- Step 1c: add the JSON columns (PostgreSQL) -->
    <changeSet id="20260707080319-1c" author="krusche" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="quiz_question" columnName="content"/>
            </not>
        </preConditions>
        <addColumn tableName="quiz_question">
            <column name="content" type="jsonb"/>
        </addColumn>
    </changeSet>
    <changeSet id="20260707080319-1d" author="krusche" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="submitted_answer" columnName="selection"/>
            </not>
        </preConditions>
        <addColumn tableName="submitted_answer">
            <column name="selection" type="jsonb"/>
        </addColumn>
    </changeSet>

    <!-- Step 2a: backfill quiz_question.content for drag-and-drop questions (PostgreSQL) -->
    <changeSet id="20260707080319-2a" author="krusche" dbms="postgresql">
        <sql>
            UPDATE quiz_question q
            SET content = jsonb_build_object(
                'type', 'drag-and-drop',
                'dropLocations', COALESCE((
                    SELECT jsonb_agg(jsonb_build_object('id', dl.id, 'posX', dl.pos_x, 'posY', dl.pos_y, 'width', dl.width, 'height', dl.height, 'invalid', COALESCE(dl.invalid, false))
                        ORDER BY dl.drop_locations_order)
                    FROM drop_location dl WHERE dl.question_id = q.id), '[]'::jsonb),
                'dragItems', COALESCE((
                    SELECT jsonb_agg(jsonb_build_object('id', di.id, 'pictureFilePath', di.picture_file_path, 'text', di.text, 'invalid', COALESCE(di.invalid, false))
                        ORDER BY di.drag_items_order)
                    FROM drag_item di WHERE di.question_id = q.id), '[]'::jsonb),
                'correctMappings', COALESCE((
                    SELECT jsonb_agg(jsonb_build_object('id', dm.id, 'dragItemId', dm.drag_item_id, 'dropLocationId', dm.drop_location_id, 'invalid', COALESCE(dm.invalid, false)))
                    FROM drag_and_drop_mapping dm WHERE dm.question_id = q.id), '[]'::jsonb))
            WHERE q.discriminator = 'DD';
        </sql>
    </changeSet>

    <!-- Step 2b: backfill submitted_answer.selection for drag-and-drop submitted answers (PostgreSQL) -->
    <changeSet id="20260707080319-2b" author="krusche" dbms="postgresql">
        <sql>
            UPDATE submitted_answer sa
            SET selection = jsonb_build_object(
                'type', 'dnd',
                'maps', COALESCE((
                    SELECT jsonb_agg(jsonb_build_object('diId', dm.drag_item_id, 'dlId', dm.drop_location_id))
                    FROM drag_and_drop_mapping dm WHERE dm.submitted_answer_id = sa.id), '[]'::jsonb))
            WHERE sa.discriminator = 'DD';
        </sql>
    </changeSet>

    <!-- Step 3a: backfill quiz_question.content for drag-and-drop questions (MySQL). NOTE: JSON_ARRAYAGG does not guarantee element order; drag-and-drop layout is coordinate-based so
         list order is not semantically significant here. -->
    <changeSet id="20260707080319-3a" author="krusche" dbms="mysql">
        <sql>
            UPDATE quiz_question q
            SET content = JSON_OBJECT(
                'type', 'drag-and-drop',
                'dropLocations', COALESCE((
                    SELECT JSON_ARRAYAGG(JSON_OBJECT('id', dl.id, 'posX', dl.pos_x, 'posY', dl.pos_y, 'width', dl.width, 'height', dl.height, 'invalid', dl.invalid = TRUE))
                    FROM drop_location dl WHERE dl.question_id = q.id), JSON_ARRAY()),
                'dragItems', COALESCE((
                    SELECT JSON_ARRAYAGG(JSON_OBJECT('id', di.id, 'pictureFilePath', di.picture_file_path, 'text', di.text, 'invalid', di.invalid = TRUE))
                    FROM drag_item di WHERE di.question_id = q.id), JSON_ARRAY()),
                'correctMappings', COALESCE((
                    SELECT JSON_ARRAYAGG(JSON_OBJECT('id', dm.id, 'dragItemId', dm.drag_item_id, 'dropLocationId', dm.drop_location_id, 'invalid', dm.invalid = TRUE))
                    FROM drag_and_drop_mapping dm WHERE dm.question_id = q.id), JSON_ARRAY()))
            WHERE q.discriminator = 'DD';
        </sql>
    </changeSet>

    <!-- Step 3b: backfill submitted_answer.selection for drag-and-drop submitted answers (MySQL) -->
    <changeSet id="20260707080319-3b" author="krusche" dbms="mysql">
        <sql>
            UPDATE submitted_answer sa
            SET selection = JSON_OBJECT(
                'type', 'dnd',
                'maps', COALESCE((
                    SELECT JSON_ARRAYAGG(JSON_OBJECT('diId', dm.drag_item_id, 'dlId', dm.drop_location_id))
                    FROM drag_and_drop_mapping dm WHERE dm.submitted_answer_id = sa.id), JSON_ARRAY()))
            WHERE sa.discriminator = 'DD';
        </sql>
    </changeSet>

    <!-- Step 4: drop the drop-location counter's foreign key and unique index. Drop-location counters now reference the drop location by its question-scoped id (unique only within a
         question), which no longer maps to a global drop_location row, so neither the FK to drop_location nor the table-wide uniqueness of drop_location_id can hold. -->
    <changeSet id="20260707080319-4a" author="krusche">
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists foreignKeyName="FK2bses6ev8komaj0jw4gcyl8te"/>
        </preConditions>
        <dropForeignKeyConstraint baseTableName="quiz_statistic_counter" constraintName="FK2bses6ev8komaj0jw4gcyl8te"/>
    </changeSet>
    <changeSet id="20260707080319-4b" author="krusche">
        <preConditions onFail="MARK_RAN">
            <indexExists indexName="UC_STATISTIC_COUNTERDROP_LOCATION_ID_COL"/>
        </preConditions>
        <dropIndex tableName="quiz_statistic_counter" indexName="UC_STATISTIC_COUNTERDROP_LOCATION_ID_COL"/>
    </changeSet>

    <!-- Step 5: fold drag-and-drop statistics counters into a JSON column on quiz_statistic. quiz_statistic itself is kept because QuizPointStatistic / PointCounter are still
         relational; only the per-drop-location rows (discriminator 'DD') and the now-unused counter columns are removed in the cleanup section (steps 15-16). New drag-and-drop
         statistics no longer write counter rows. -->
    <changeSet id="20260707080319-5a" author="krusche" dbms="mysql,h2">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="quiz_statistic" columnName="counters"/>
            </not>
        </preConditions>
        <addColumn tableName="quiz_statistic">
            <column name="counters" type="json"/>
        </addColumn>
    </changeSet>
    <changeSet id="20260707080319-5b" author="krusche" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="quiz_statistic" columnName="counters"/>
            </not>
        </preConditions>
        <addColumn tableName="quiz_statistic">
            <column name="counters" type="jsonb"/>
        </addColumn>
    </changeSet>

    <!-- Step 6a: backfill quiz_statistic.counters for drag-and-drop question statistics (PostgreSQL) -->
    <changeSet id="20260707080319-6a" author="krusche" dbms="postgresql">
        <sql>
            UPDATE quiz_statistic qs
            SET counters = COALESCE((
                SELECT jsonb_agg(jsonb_build_object('dropLocationId', c.drop_location_id, 'ratedCounter', COALESCE(c.rated_counter, 0), 'unRatedCounter', COALESCE(c.un_rated_counter, 0)))
                FROM quiz_statistic_counter c WHERE c.drag_and_drop_question_statistic_id = qs.id), '[]'::jsonb)
            WHERE qs.discriminator = 'DD';
        </sql>
    </changeSet>

    <!-- Step 6b: backfill quiz_statistic.counters for drag-and-drop question statistics (MySQL) -->
    <changeSet id="20260707080319-6b" author="krusche" dbms="mysql">
        <sql>
            UPDATE quiz_statistic qs
            SET counters = COALESCE((
                SELECT JSON_ARRAYAGG(JSON_OBJECT('dropLocationId', c.drop_location_id, 'ratedCounter', COALESCE(c.rated_counter, 0), 'unRatedCounter', COALESCE(c.un_rated_counter, 0)))
                FROM quiz_statistic_counter c WHERE c.drag_and_drop_question_statistic_id = qs.id), JSON_ARRAY())
            WHERE qs.discriminator = 'DD';
        </sql>
    </changeSet>

    <!--
      Quiz JSON persistence, iteration 2 (Short-Answer). Reuses the columns added above (quiz_question.content, submitted_answer.selection, quiz_statistic.counters).
      Folds a short-answer question's spots / solutions / correct mappings into quiz_question.content, a submission's submitted texts into submitted_answer.selection, and the
      per-spot statistics counters into quiz_statistic.counters. The old tables (short_answer_spot, short_answer_solution, short_answer_mapping, short_answer_submitted_text) are
      dropped in the cleanup section at the end of this changelog (step 17). Existing component ids are preserved verbatim (they become the question-scoped ids inside the JSON).
    -->

    <!-- Step 7: drop the spot counter's foreign key and unique index. Short-answer spot counters now reference the spot by its question-scoped id (unique only within a question),
         which no longer maps to a global short_answer_spot row, so neither the FK to short_answer_spot nor the table-wide uniqueness of spot_id can hold. -->
    <changeSet id="20260707080319-7a" author="krusche">
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists foreignKeyName="FKoqgu1clyd02qbo86silw1uhmk"/>
        </preConditions>
        <dropForeignKeyConstraint baseTableName="quiz_statistic_counter" constraintName="FKoqgu1clyd02qbo86silw1uhmk"/>
    </changeSet>
    <changeSet id="20260707080319-7b" author="krusche">
        <preConditions onFail="MARK_RAN">
            <indexExists indexName="UC_STATISTIC_COUNTERSPOT_ID_COL"/>
        </preConditions>
        <dropIndex tableName="quiz_statistic_counter" indexName="UC_STATISTIC_COUNTERSPOT_ID_COL"/>
    </changeSet>

    <!-- Step 8a: backfill quiz_question.content for short-answer questions (PostgreSQL) -->
    <changeSet id="20260707080319-8a" author="krusche" dbms="postgresql">
        <sql>
            UPDATE quiz_question q
            SET content = jsonb_build_object(
                'type', 'short-answer',
                'spots', COALESCE((
                    SELECT jsonb_agg(jsonb_build_object('id', s.id, 'spotNr', s.spot_nr, 'width', s.width, 'invalid', COALESCE(s.invalid, false))
                        ORDER BY s.spots_order)
                    FROM short_answer_spot s WHERE s.question_id = q.id), '[]'::jsonb),
                'solutions', COALESCE((
                    SELECT jsonb_agg(jsonb_build_object('id', s.id, 'text', s.text, 'invalid', COALESCE(s.invalid, false))
                        ORDER BY s.solutions_order)
                    FROM short_answer_solution s WHERE s.question_id = q.id), '[]'::jsonb),
                'correctMappings', COALESCE((
                    SELECT jsonb_agg(jsonb_build_object('id', m.id, 'spotId', m.spot_id, 'solutionId', m.solution_id, 'invalid', COALESCE(m.invalid, false)))
                    FROM short_answer_mapping m WHERE m.question_id = q.id), '[]'::jsonb))
            WHERE q.discriminator = 'SA';
        </sql>
    </changeSet>

    <!-- Step 8b: backfill quiz_question.content for short-answer questions (MySQL). NOTE: JSON_ARRAYAGG does not guarantee element order; spot/solution list order is not
         semantically significant (spots carry their own spot_nr, solutions are matched as a set), so the missing ORDER BY is acceptable here. -->
    <changeSet id="20260707080319-8b" author="krusche" dbms="mysql">
        <sql>
            UPDATE quiz_question q
            SET content = JSON_OBJECT(
                'type', 'short-answer',
                'spots', COALESCE((
                    SELECT JSON_ARRAYAGG(JSON_OBJECT('id', s.id, 'spotNr', s.spot_nr, 'width', s.width, 'invalid', s.invalid = TRUE))
                    FROM short_answer_spot s WHERE s.question_id = q.id), JSON_ARRAY()),
                'solutions', COALESCE((
                    SELECT JSON_ARRAYAGG(JSON_OBJECT('id', s.id, 'text', s.text, 'invalid', s.invalid = TRUE))
                    FROM short_answer_solution s WHERE s.question_id = q.id), JSON_ARRAY()),
                'correctMappings', COALESCE((
                    SELECT JSON_ARRAYAGG(JSON_OBJECT('id', m.id, 'spotId', m.spot_id, 'solutionId', m.solution_id, 'invalid', m.invalid = TRUE))
                    FROM short_answer_mapping m WHERE m.question_id = q.id), JSON_ARRAY()))
            WHERE q.discriminator = 'SA';
        </sql>
    </changeSet>

