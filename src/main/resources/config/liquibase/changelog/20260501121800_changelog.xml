<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20260501-1a-add-column-with-differing-format-mysql" author="PeterNiedermoser">
        <preConditions onFail="MARK_RAN">
            <or>
                <dbms type="mysql"/>
                <dbms type="h2"/>
            </or>
        </preConditions>
        <addColumn tableName="participation">
            <column name="iris_verdict_review" type="enum('REVIEWABLE', 'NEEDS_REVIEW', 'ACCEPTED', 'REJECTED')"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260501-1b-add-column-with-differing-format-postgresql" author="PeterNiedermoser">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <addColumn tableName="participation">
            <column name="iris_verdict_review" type="varchar(20)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260501-2-add-column" author="PeterNiedermoser">
        <addColumn tableName="participation">
            <column name="iris_verified_score_old" type="double"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>