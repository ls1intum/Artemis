<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20260921214023-01-hyperion-authoring-run" author="FelixTJDietrich">
        <comment>Retain authoring provenance and canonical before/after version links independently of replay TTLs.</comment>
        <createTable tableName="hyperion_authoring_run">
            <column name="id" type="bigint" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="job_id" type="varchar(36)"><constraints nullable="false" unique="true" uniqueConstraintName="uk_hyperion_authoring_job"/></column>
            <column name="exercise_id" type="bigint"><constraints nullable="false"/></column>
            <column name="source_exercise_id" type="bigint"/>
            <column name="owner_id" type="bigint"/>
            <column name="kind" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="status" type="varchar(24)"><constraints nullable="false"/></column>
            <column name="started_at" type="datetime(3)"><constraints nullable="false"/></column>
            <column name="finished_at" type="datetime(3)"/>
            <column name="mutation_started_at" type="datetime(3)"/>
            <column name="before_version_id" type="bigint"/>
            <column name="after_version_id" type="bigint"/>
            <column name="repository_branch" type="varchar(255)"/>
            <column name="live_exercise_changed" type="boolean"/>
            <column name="reverted_at" type="datetime(3)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="hyperion_authoring_run" baseColumnNames="exercise_id" referencedTableName="exercise" referencedColumnNames="id" constraintName="fk_authoring_run_exercise_id" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="hyperion_authoring_run" baseColumnNames="source_exercise_id" referencedTableName="exercise" referencedColumnNames="id" constraintName="fk_authoring_run_source_exercise_id" onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableName="hyperion_authoring_run" baseColumnNames="owner_id" referencedTableName="jhi_user" referencedColumnNames="id" constraintName="fk_authoring_run_owner_id" onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableName="hyperion_authoring_run" baseColumnNames="before_version_id" referencedTableName="exercise_version" referencedColumnNames="id" constraintName="fk_authoring_run_before_version_id" onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableName="hyperion_authoring_run" baseColumnNames="after_version_id" referencedTableName="exercise_version" referencedColumnNames="id" constraintName="fk_authoring_run_after_version_id" onDelete="SET NULL"/>
        <createIndex tableName="hyperion_authoring_run" indexName="idx_authoring_run_owner"><column name="owner_id"/><column name="id"/></createIndex>
        <createIndex tableName="hyperion_authoring_run" indexName="idx_authoring_run_exercise"><column name="exercise_id"/><column name="id"/></createIndex>
    </changeSet>
</databaseChangeLog>
