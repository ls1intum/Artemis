<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
                   logicalFilePath="config/liquibase/changelog/20261014150000_changelog.xml">
    <changeSet id="20261014150000-01-exercise-copy-readers" author="felixtjdietrich">
        <addColumn tableName="exercise">
            <column name="write_owner_reader_count" type="int" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </addColumn>
        <createTable tableName="exercise_write_reader">
            <column name="token" type="varchar(64)"><constraints primaryKey="true" nullable="false" primaryKeyName="pk_exercise_write_reader"/></column>
            <column name="exercise_id" type="bigint"><constraints nullable="false"/></column>
            <column name="owner" type="varchar(255)"><constraints nullable="false"/></column>
            <column name="started_at" type="datetime(3)"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="exercise_write_reader" indexName="idx_exercise_write_reader_exercise"><column name="exercise_id"/></createIndex>
        <addForeignKeyConstraint baseTableName="exercise_write_reader" baseColumnNames="exercise_id" referencedTableName="exercise" referencedColumnNames="id"
                                 constraintName="fk_exercise_write_reader_exercise" onDelete="CASCADE"/>
        <rollback>
            <dropTable tableName="exercise_write_reader"/>
            <dropColumn tableName="exercise" columnName="write_owner_reader_count"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
