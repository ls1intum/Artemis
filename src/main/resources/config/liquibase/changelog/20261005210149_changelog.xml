<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- A course request now records whether the requested course is grade relevant, so the answer is known before an
         administrator accepts the request. Existing requests default to grade relevant, the same safe default a course
         without an explicit configuration has (it keeps student data for the longer retention period). -->
    <changeSet id="20261005210149-01-add-course-request-grade-relevant" author="krusche">
        <addColumn tableName="course_request">
            <column name="grade_relevant" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- A test course can never be grade relevant, so the existing requests for a test course must not claim otherwise. -->
    <changeSet id="20261005210149-02-course-request-test-course-not-grade-relevant" author="krusche">
        <update tableName="course_request">
            <column name="grade_relevant" valueBoolean="false"/>
            <where>test_course = TRUE</where>
        </update>
        <rollback/>
    </changeSet>
</databaseChangeLog>
