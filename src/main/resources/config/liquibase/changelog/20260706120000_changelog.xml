<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260706120000-1-create-presentation-assessment" author="suckart">
        <createTable tableName="presentation_assessment">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_presentation_assessment" nullable="false"/>
            </column>
            <column name="title" type="varchar(255)"><constraints nullable="false"/></column>
            <column name="description" type="varchar(1000)"/>
            <column name="max_points" type="double"><constraints nullable="false"/></column>
            <column name="course_id" type="bigint"><constraints nullable="false"/></column>
            <column name="exercise_id" type="bigint"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="course_id" baseTableName="presentation_assessment" constraintName="fk_presentation_assessment_course_id"
                                 referencedColumnNames="id" referencedTableName="course" onDelete="CASCADE" onUpdate="RESTRICT"/>
        <addForeignKeyConstraint baseColumnNames="exercise_id" baseTableName="presentation_assessment" constraintName="fk_presentation_assessment_exercise_id"
                                 referencedColumnNames="id" referencedTableName="exercise" onDelete="SET NULL"/>
        <createIndex indexName="idx_presentation_assessment_course_id" tableName="presentation_assessment"><column name="course_id"/></createIndex>
        <createIndex indexName="idx_presentation_assessment_exercise_id" tableName="presentation_assessment"><column name="exercise_id"/></createIndex>

        <createTable tableName="presentation_assessment_instance">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_presentation_assessment_instance" nullable="false"/>
            </column>
            <column name="presentation_assessment_id" type="bigint"><constraints nullable="false"/></column>
            <column name="presentation_date" type="datetime(3)"><constraints nullable="false"/></column>
            <column name="result_points" type="double"/>
            <column name="language" type="varchar(10)"><constraints nullable="false"/></column>
            <column name="presentation_mode" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="location" type="varchar(255)"/>
            <column name="meeting_link" type="varchar(1000)"/>
            <column name="remark" type="varchar(1000)"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="presentation_assessment_id" baseTableName="presentation_assessment_instance"
                                 constraintName="fk_presentation_instance_assessment_id" referencedColumnNames="id"
                                 referencedTableName="presentation_assessment" onDelete="CASCADE"/>
        <createIndex indexName="idx_presentation_instance_assessment_id" tableName="presentation_assessment_instance">
            <column name="presentation_assessment_id"/>
        </createIndex>

        <createTable tableName="presentation_assessment_instance_student">
            <column name="presentation_assessment_instance_id" type="bigint"><constraints nullable="false"/></column>
            <column name="student_id" type="bigint"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="presentation_assessment_instance_student" columnNames="presentation_assessment_instance_id, student_id"
                       constraintName="pk_presentation_instance_student"/>
        <addForeignKeyConstraint baseColumnNames="presentation_assessment_instance_id" baseTableName="presentation_assessment_instance_student"
                                 constraintName="fk_presentation_instance_student_instance_id" referencedColumnNames="id"
                                 referencedTableName="presentation_assessment_instance" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseColumnNames="student_id" baseTableName="presentation_assessment_instance_student"
                                 constraintName="fk_presentation_instance_student_student_id" referencedColumnNames="id"
                                 referencedTableName="jhi_user" onDelete="CASCADE"/>
        <createIndex indexName="idx_presentation_instance_student_student_id" tableName="presentation_assessment_instance_student">
            <column name="student_id"/>
        </createIndex>

        <addColumn tableName="course">
            <column name="presentation_assessments_enabled" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
