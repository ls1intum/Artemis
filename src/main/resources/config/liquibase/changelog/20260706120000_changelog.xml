<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260706120000-1" author="artemis">
        <createTable tableName="presentation_assessment">
            <column name="id" type="bigint" autoIncrement="${autoIncrement}">
                <constraints primaryKey="true" primaryKeyName="pk_presentation_assessment" nullable="false"/>
            </column>
            <column name="title" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(1000)"/>
            <column name="max_points" type="double">
                <constraints nullable="false"/>
            </column>
            <column name="presentation_date" type="timestamp"/>
            <column name="course_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="course_id"
                                 baseTableName="presentation_assessment"
                                 constraintName="fk_presentation_assessment_course_id"
                                 referencedColumnNames="id"
                                 referencedTableName="course"/>

        <createIndex indexName="idx_presentation_assessment_course_id" tableName="presentation_assessment">
            <column name="course_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260706120000-2" author="artemis">
        <addAutoIncrement tableName="presentation_assessment"
                          columnName="id"
                          columnDataType="bigint"/>
    </changeSet>

    <changeSet id="20260706120000-3" author="artemis">
        <addColumn tableName="presentation_assessment">
            <column name="result_points" type="double"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260706120000-4" author="artemis">
        <dropForeignKeyConstraint baseTableName="presentation_assessment"
                                  constraintName="fk_presentation_assessment_course_id"/>
        <addForeignKeyConstraint baseColumnNames="course_id"
                                 baseTableName="presentation_assessment"
                                 constraintName="fk_presentation_assessment_course_id"
                                 referencedColumnNames="id"
                                 referencedTableName="course"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="20260706120000-5" author="artemis">
        <createTable tableName="presentation_assessment_student">
            <column name="presentation_assessment_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="student_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="presentation_assessment_student"
                       columnNames="presentation_assessment_id, student_id"
                       constraintName="pk_presentation_assessment_student"/>

        <addForeignKeyConstraint baseColumnNames="presentation_assessment_id"
                                 baseTableName="presentation_assessment_student"
                                 constraintName="fk_presentation_assessment_student_assessment_id"
                                 referencedColumnNames="id"
                                 referencedTableName="presentation_assessment"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseColumnNames="student_id"
                                 baseTableName="presentation_assessment_student"
                                 constraintName="fk_presentation_assessment_student_student_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"
                                 onDelete="CASCADE"/>

        <createIndex indexName="idx_presentation_assessment_student_student_id" tableName="presentation_assessment_student">
            <column name="student_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
