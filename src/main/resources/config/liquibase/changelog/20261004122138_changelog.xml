<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
    A course Athena configuration had no key of its own. The course pointed at it through a nullable column, so nothing
    tied the configuration to the course it configures and deleting the course could leave the row behind for good.

    The configuration now holds the key. A deleted course takes its Athena configuration with it, and a configuration
    that belongs to no course can no longer be written.
    -->

    <changeSet id="20261004122138-01-athena-configuration-owns-its-course-key" author="krusche">
        <!-- Two courses cannot share a configuration. If they do, nothing says which one owns it, so the upgrade stops rather than guessing. -->
        <preConditions onFail="HALT">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM (SELECT athena_config_id FROM course WHERE athena_config_id IS NOT NULL
                GROUP BY athena_config_id HAVING COUNT(*) &gt; 1) shared</sqlCheck>
        </preConditions>
        <comment>Move the course key onto the Athena configuration, so that it cannot outlive the course it configures.</comment>
        <addColumn tableName="course_athena_config">
            <column name="course_id" type="BIGINT"/>
        </addColumn>
        <sql>UPDATE course_athena_config SET course_id =
            (SELECT MIN(course.id) FROM course WHERE course.athena_config_id = course_athena_config.id);</sql>
        <rollback>
            <dropColumn tableName="course_athena_config" columnName="course_id"/>
        </rollback>
    </changeSet>

    <changeSet id="20261004122138-02-remove-athena-configurations-no-course-points-at" author="krusche">
        <comment>Remove the Athena configurations that no course points at.</comment>
        <!--
        A configuration no course points at configures nothing. It carried no key of its own, and nothing lists one except
        through the course that named it, so it has been unreachable from the moment the course stopped naming it. Nothing
        else references the table, so the statement removes nothing but the rows themselves.
        -->
        <sql>DELETE FROM course_athena_config WHERE course_id IS NULL;</sql>
        <rollback/>
    </changeSet>

    <changeSet id="20261004122138-03-athena-configuration-course-constraints" author="krusche">
        <addNotNullConstraint tableName="course_athena_config" columnName="course_id" columnDataType="BIGINT"/>
        <addUniqueConstraint tableName="course_athena_config" columnNames="course_id" constraintName="UK_COURSE_ATHENA_CONFIG_COURSE"/>
        <addForeignKeyConstraint baseTableName="course_athena_config" baseColumnNames="course_id" constraintName="FK_COURSE_ATHENA_CONFIG_COURSE"
                                 referencedTableName="course" referencedColumnNames="id" onDelete="CASCADE"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="course_athena_config" constraintName="FK_COURSE_ATHENA_CONFIG_COURSE"/>
            <dropUniqueConstraint tableName="course_athena_config" constraintName="UK_COURSE_ATHENA_CONFIG_COURSE"/>
            <dropNotNullConstraint tableName="course_athena_config" columnName="course_id" columnDataType="BIGINT"/>
        </rollback>
    </changeSet>

    <changeSet id="20261004122138-04-courses-stop-pointing-at-their-athena-configuration" author="krusche">
        <comment>The configuration holds the key, so the course no longer points at it.</comment>
        <dropForeignKeyConstraint baseTableName="course" constraintName="fk_course_athena_config_id"/>
        <dropColumn tableName="course" columnName="athena_config_id"/>
        <rollback>
            <addColumn tableName="course">
                <column name="athena_config_id" type="BIGINT"/>
            </addColumn>
            <sql>UPDATE course SET athena_config_id =
                (SELECT config.id FROM course_athena_config config WHERE config.course_id = course.id);</sql>
            <addUniqueConstraint tableName="course" columnNames="athena_config_id" constraintName="uc_course_athena_config_id"/>
            <addForeignKeyConstraint baseTableName="course" baseColumnNames="athena_config_id" constraintName="fk_course_athena_config_id"
                                     referencedTableName="course_athena_config" referencedColumnNames="id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
