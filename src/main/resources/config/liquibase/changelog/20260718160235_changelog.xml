<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Drop the student_course_analytics_dashboard_enabled column from the course table (Student Course Analytics Dashboard feature removed) -->
    <changeSet id="20260718160235-1" author="krusche">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="course" columnName="student_course_analytics_dashboard_enabled"/>
        </preConditions>
        <dropColumn tableName="course" columnName="student_course_analytics_dashboard_enabled"/>
    </changeSet>
</databaseChangeLog>
