<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
    Drops schema that no entity maps and no code references any more.

    Determined by diffing the Hibernate mapping model (built from all annotated classes) against the
    schema Liquibase produces, then verifying every candidate against the whole repository - server,
    client, tests and generated OpenAPI - not just src/main/java.

    Three of these were already tracked in the code:
      - Result.java              "TODO: drop the legacy feedbacks_order DB column"
      - ProgrammingExercise.java "TODO: delete publish_build_plan_url from exercise using liquibase"
      - DragAndDropQuestion.java / ShortAnswerQuestion.java  correct_mappings_order, issue #12807

    Note on the initial schema: the four dropped tables are still created by
    00000000000000_initial_schema.xml, which cannot be edited - it consists of only three changesets
    covering the entire schema, so changing it would invalidate a checksum already recorded on every
    installation. Fresh installations therefore create these tables and drop them again here, which
    costs milliseconds. Same reasoning for the dropped columns.

    DROP COLUMN is INSTANT on MySQL 8.0.29+, so table size is irrelevant - feedback (42.8M rows /
    8.5GB) drops as quickly as a small table. No space is reclaimed until a table is next rebuilt.
    -->

    <!-- ===================================================================== -->
    <!-- Ordering columns orphaned by @OrderColumn removals                    -->
    <!-- ===================================================================== -->

    <!-- #12610 stopped ordering result.feedbacks to avoid the @OrderColumn null-index race. -->
    <changeSet id="20260728223939-01-drop-feedback-feedbacks-order" author="krusche">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="feedback" columnName="feedbacks_order"/>
        </preConditions>
        <dropColumn tableName="feedback" columnName="feedbacks_order"/>
    </changeSet>

    <!-- #12640 converted the quiz mapping collections to bidirectional mappedBy; tracked in #12807. -->
    <changeSet id="20260728223939-02-drop-drag-and-drop-mapping-order" author="krusche">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="drag_and_drop_mapping" columnName="correct_mappings_order"/>
        </preConditions>
        <dropColumn tableName="drag_and_drop_mapping" columnName="correct_mappings_order"/>
    </changeSet>

    <changeSet id="20260728223939-03-drop-short-answer-mapping-order" author="krusche">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="short_answer_mapping" columnName="correct_mappings_order"/>
        </preConditions>
        <dropColumn tableName="short_answer_mapping" columnName="correct_mappings_order"/>
    </changeSet>

