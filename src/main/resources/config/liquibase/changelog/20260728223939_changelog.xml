    <!-- ===================================================================== -->
    <!-- Iris session legacy columns - completing a staged deletion            -->
    <!-- ===================================================================== -->
    <!--
    20260410144433 replaced iris_session.exercise_id / lecture_id with the polymorphic entity_id plus
    chat_mode, and renamed the old columns rather than dropping them ("rename-first delete policy...
    the actual dropColumn happens in a later release once we are confident no rollback is needed").
    That release is this one.

    Verified against production before dropping: of 359,948 rows with legacy_exercise_id, 359,947 have
    entity_id equal to it; of 75,346 with legacy_lecture_id, 75,345 match. The two exceptions are
    pre-existing inconsistencies where the discriminator disagreed with the populated legacy column,
    so the migration derived entity_id from the other one. Their values are recorded here so the
    information survives the drop:

      iris_session 634671  chat_mode=COURSE_CHAT   entity_id=531   legacy_lecture_id=1824
      iris_session 676908  chat_mode=LECTURE_CHAT  entity_id=1824  legacy_exercise_id=19195
    -->

    <changeSet id="20260728223939-13-drop-iris-session-legacy-exercise-id" author="krusche">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="iris_session" columnName="legacy_exercise_id"/>
        </preConditions>
        <dropColumn tableName="iris_session" columnName="legacy_exercise_id"/>
