<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
    An online course configuration had no key of its own. The course pointed at it through a nullable column, so nothing
    tied the configuration to the course it configures and deleting the course could leave the row behind for good.

    The configuration now holds the key. A deleted course takes its configuration with it, and a configuration that
    belongs to no course can no longer be written.
    -->

    <changeSet id="20261003234910-01-online-course-configuration-owns-its-course-key" author="krusche">
        <!-- Two courses cannot share a configuration. If they do, nothing says which one owns it, so the upgrade stops rather than guessing. -->
        <preConditions onFail="HALT">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM (SELECT online_course_configuration_id FROM course WHERE online_course_configuration_id IS NOT NULL
                GROUP BY online_course_configuration_id HAVING COUNT(*) &gt; 1) shared</sqlCheck>
        </preConditions>
        <comment>Move the course key onto the online course configuration, so that it cannot outlive the course it configures.</comment>
        <addColumn tableName="online_course_configuration">
            <column name="course_id" type="BIGINT"/>
        </addColumn>
        <sql>UPDATE online_course_configuration SET course_id =
            (SELECT MIN(course.id) FROM course WHERE course.online_course_configuration_id = online_course_configuration.id);</sql>
        <rollback>
            <dropColumn tableName="online_course_configuration" columnName="course_id"/>
        </rollback>
    </changeSet>

    <changeSet id="20261003234910-02-remove-online-course-configurations-no-course-points-at" author="krusche">
        <comment>Remove the configurations that no course points at.</comment>
        <!--
        A configuration no course points at configures nothing. It carried no key of its own, and nothing lists one except
        through the course that named it, so it has been unreachable from the moment the course stopped naming it. Nothing
        else references the table, so the statement removes nothing but the rows themselves.
        -->
        <sql>DELETE FROM online_course_configuration WHERE course_id IS NULL;</sql>
        <rollback/>
    </changeSet>

    <changeSet id="20261003234910-03-online-course-configuration-course-constraints" author="krusche">
        <addNotNullConstraint tableName="online_course_configuration" columnName="course_id" columnDataType="BIGINT"/>
        <addUniqueConstraint tableName="online_course_configuration" columnNames="course_id" constraintName="UK_ONLINE_COURSE_CONFIGURATION_COURSE"/>
        <addForeignKeyConstraint baseTableName="online_course_configuration" baseColumnNames="course_id" constraintName="FK_ONLINE_COURSE_CONFIGURATION_COURSE"
                                 referencedTableName="course" referencedColumnNames="id" onDelete="CASCADE"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="online_course_configuration" constraintName="FK_ONLINE_COURSE_CONFIGURATION_COURSE"/>
            <dropUniqueConstraint tableName="online_course_configuration" constraintName="UK_ONLINE_COURSE_CONFIGURATION_COURSE"/>
            <dropNotNullConstraint tableName="online_course_configuration" columnName="course_id" columnDataType="BIGINT"/>
        </rollback>
    </changeSet>

    <changeSet id="20261003234910-04-courses-stop-pointing-at-their-online-course-configuration" author="krusche">
        <comment>The configuration holds the key, so the course no longer points at it.</comment>
        <dropForeignKeyConstraint baseTableName="course" constraintName="FKjkn43f39191eamelk94a9837"/>
        <dropColumn tableName="course" columnName="online_course_configuration_id"/>
        <rollback>
            <addColumn tableName="course">
                <column name="online_course_configuration_id" type="BIGINT"/>
            </addColumn>
            <sql>UPDATE course SET online_course_configuration_id =
                (SELECT config.id FROM online_course_configuration config WHERE config.course_id = course.id);</sql>
            <addForeignKeyConstraint baseTableName="course" baseColumnNames="online_course_configuration_id" constraintName="FKjkn43f39191eamelk94a9837"
                                     referencedTableName="online_course_configuration" referencedColumnNames="id" onDelete="RESTRICT"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
