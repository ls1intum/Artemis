<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
    The feature usage inventory learns two things about each endpoint: how its calls count (a user action, a view, an
    automatic call by the client, or a call by another system) and which controller serves it. Both are re-derived from
    the annotations on every startup, so live endpoints are reclassified as soon as the server starts.

    The backfill is for the rows that never re-register: endpoints that no longer exist, and git and background features
    that nobody has used since the upgrade. It applies the same default the server derives, by verb and path, so their
    history counts under the same rules as everything else.

    The interaction is NOT NULL with a default rather than without one, so that the previous version, which does not know
    the column, can still insert inventory rows after a rollback to it.
    -->

    <changeSet id="20260924100439-01-tracked-feature-interaction-and-resource" author="krusche">
        <comment>Add how calls to a tracked feature count, and the controller serving it.</comment>
        <addColumn tableName="tracked_feature">
            <column name="interaction" type="varchar(16)" defaultValue="ACTION">
                <constraints nullable="false"/>
            </column>
            <column name="resource" type="varchar(128)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260924100439-02-tracked-feature-interaction-backfill" author="krusche">
        <comment>Derive the interaction of rows that were written before the column existed.</comment>
        <update tableName="tracked_feature">
            <column name="interaction" value="VIEW"/>
            <where>feature_kind = 'REST' AND (identifier LIKE 'GET %' OR identifier LIKE 'HEAD %')</where>
        </update>
        <update tableName="tracked_feature">
            <column name="interaction" value="SYSTEM"/>
            <where>feature_kind = 'REST' AND identifier LIKE '% api/%/internal/%'</where>
        </update>
        <update tableName="tracked_feature">
            <column name="interaction" value="VIEW"/>
            <where>feature_kind = 'GIT' AND identifier LIKE 'fetch/%'</where>
        </update>
        <!-- nothing to undo: rolling back the previous changeset drops the column -->
        <rollback/>
    </changeSet>
</databaseChangeLog>
