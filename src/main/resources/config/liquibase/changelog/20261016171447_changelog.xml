<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
                   logicalFilePath="config/liquibase/changelog/20261016171447_changelog.xml">

    <!--
        Record which file revision (attachment version and SHA-256 hash) a slide was split from.

        The student version of an attachment is generated by removing the hidden slides, by slide number, from the stored
        file. That is only correct while the slides belong to that file. They do not while the asynchronous split after a
        new file is still running, and they no longer do after a failed split, which restores the previous slides while
        the new file stays stored. With the revision on every slide, regeneration and the student downloads can tell, and
        fail closed instead of removing the wrong pages.

        Both columns are nullable and nothing else changes, so the previous application version, which neither reads nor
        writes them, keeps working against this schema.

        The current slides are backfilled with the revision of their unit's attachment, on the assumption that existing
        decks belong to their stored file. Only units with exactly one attachment row are backfilled: the schema does not
        enforce one attachment per unit, and for a unit with several the copy would be ambiguous. Slides left without a
        revision count as not matching their file until the next upload splits the file again. Superseded slides are not
        read by anything that compares revisions and stay empty.
    -->

    <changeSet id="20261016171447-01-slide-attachment-revision" author="bassner">
        <addColumn tableName="slide">
            <column name="attachment_version" type="int"/>
            <column name="attachment_sha256_hash" type="varchar(64)"/>
        </addColumn>
        <sql>
            UPDATE slide
            SET attachment_version = (SELECT a.version FROM attachment a WHERE a.attachment_unit_id = slide.attachment_unit_id),
                attachment_sha256_hash = (SELECT a.sha256_hash FROM attachment a WHERE a.attachment_unit_id = slide.attachment_unit_id)
            WHERE slide.superseded = FALSE
              AND slide.attachment_unit_id IS NOT NULL
              AND (SELECT COUNT(*) FROM attachment a2 WHERE a2.attachment_unit_id = slide.attachment_unit_id) = 1
        </sql>
        <rollback>
            <dropColumn tableName="slide" columnName="attachment_sha256_hash"/>
            <dropColumn tableName="slide" columnName="attachment_version"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
