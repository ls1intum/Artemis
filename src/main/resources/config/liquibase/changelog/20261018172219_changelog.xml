<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
                   logicalFilePath="config/liquibase/changelog/20261018172219_changelog.xml">

    <!--
        Feature bonus: tutors award points for features students implemented beyond the task, and the points convert into a
        percentage the instructor adds on top of the final grade. The conversion is configured per course, awarding is enabled
        per exercise, and every award is stored on its own, keyed by the participation of the student or team.
    -->

    <changeSet id="20261018172219-01-add-feature-bonus-settings-to-course-configuration" author="SultanTheHL">
        <comment>Both columns are empty while the course does not use the feature bonus.</comment>
        <addColumn tableName="course_configuration">
            <column name="feature_bonus_percent_per_point" type="DOUBLE"/>
            <column name="feature_bonus_max_percent" type="DOUBLE"/>
        </addColumn>
    </changeSet>

    <changeSet id="20261018172219-02-add-feature-bonus-enabled-to-programming-exercise-details" author="SultanTheHL">
        <addColumn tableName="programming_exercise_details">
            <column name="feature_bonus_enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20261018172219-03-create-feature-bonus-award" author="SultanTheHL">
        <createTable tableName="feature_bonus_award">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="participation_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="justification" type="VARCHAR(2000)"/>
            <column name="points" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="datetime(3)"/>
            <column name="last_modified_by" type="VARCHAR(50)"/>
            <column name="last_modified_date" type="datetime(3)"/>
        </createTable>
        <createIndex tableName="feature_bonus_award" indexName="IDX_FEATURE_BONUS_AWARD_PARTICIPATION">
            <column name="participation_id"/>
        </createIndex>
        <!-- An award belongs to its participation and goes with it, so deleting a participation, exercise or course needs no extra step. -->
        <addForeignKeyConstraint baseTableName="feature_bonus_award" baseColumnNames="participation_id" constraintName="FK_FEATURE_BONUS_AWARD_PARTICIPATION"
                                 referencedTableName="participation" referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
