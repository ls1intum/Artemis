<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Add an explicit is_test_user flag on jhi_user to replace the non-sargable "login NOT LIKE '%test%'" heuristic
         used in usage statistics. The value is managed explicitly: backfilled here for existing logins containing
         "test", and settable via the user CSV import. -->
    <changeSet id="20260718130000-01-add-is-test-user-column" author="krusche">
        <addColumn tableName="jhi_user">
            <column name="is_test_user" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Backfill: mark existing accounts whose login contains "test" (case-insensitive), preserving the previous
         NOT LIKE '%test%' behaviour. Standard SQL, so a single portable <update> works on MySQL and PostgreSQL. -->
    <changeSet id="20260718130000-02-backfill-is-test-user" author="krusche">
        <update tableName="jhi_user">
            <column name="is_test_user" valueBoolean="true"/>
            <where>LOWER(login) LIKE '%test%'</where>
        </update>
    </changeSet>

    <!-- Performance indexes for slow queries identified in the production slow-query log.
         Every create is guarded by NOT indexExists and every drop by indexExists (onFail=MARK_RAN), so these
         changesets are idempotent: an operator may pre-create the indexes online (ALGORITHM=INPLACE, LOCK=NONE)
         before the deploy using the same index names, and the migration will simply skip them. Creates precede
         their paired drops so the covering index always exists before the redundant prefix index is removed. -->

    <!-- Admin "logged-in users" statistics: make it covering by adding event_type to (principal, event_date). -->
    <changeSet id="20260718130000-03-create-idx-audit-principal-date-type" author="krusche">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_persistent_audit_event_principal_date_type" tableName="jhi_persistent_audit_event"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_persistent_audit_event_principal_date_type" tableName="jhi_persistent_audit_event">
            <column name="principal"/>
            <column name="event_date"/>
            <column name="event_type"/>
        </createIndex>
    </changeSet>

    <!-- Drop the now-redundant prefix index (principal, event_date); superseded by the covering index above. -->
    <changeSet id="20260718130000-04-drop-idx-audit-principal-date" author="krusche">
        <preConditions onFail="MARK_RAN">
            <indexExists indexName="idx_persistent_audit_event" tableName="jhi_persistent_audit_event"/>
        </preConditions>
        <dropIndex indexName="idx_persistent_audit_event" tableName="jhi_persistent_audit_event"/>
    </changeSet>

    <!-- Nightly VCS access log cleanup does a full scan on timestamp (no index today). -->
    <changeSet id="20260718130000-05-create-idx-vcs-access-log-timestamp" author="krusche">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_vcs_access_log_timestamp" tableName="vcs_access_log"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_vcs_access_log_timestamp" tableName="vcs_access_log">
            <column name="timestamp"/>
        </createIndex>
    </changeSet>

    <!-- Build-job average-duration statistics: covering index so AVG(timestampdiff(...)) needs no row lookups. -->
    <changeSet id="20260718130000-06-create-idx-build-job-exercise-result-dates" author="krusche">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_build_job_exercise_result_dates" tableName="build_job"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_build_job_exercise_result_dates" tableName="build_job">
            <column name="exercise_id"/>
            <column name="build_job_result"/>
            <column name="build_start_date"/>
            <column name="build_completion_date"/>
        </createIndex>
    </changeSet>

    <!-- Drop the now-redundant prefix index (exercise_id, build_job_result); superseded by the covering index above. -->
    <changeSet id="20260718130000-07-drop-idx-exercise-result" author="krusche">
        <preConditions onFail="MARK_RAN">
            <indexExists indexName="idx_exercise_result" tableName="build_job"/>
        </preConditions>
        <dropIndex indexName="idx_exercise_result" tableName="build_job"/>
    </changeSet>

    <!-- Startup scheduler scans all participations for future individual due dates (no index today). -->
    <changeSet id="20260718130000-08-create-idx-participation-individual-due-date" author="krusche">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_participation_individual_due_date" tableName="participation"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_participation_individual_due_date" tableName="participation">
            <column name="individual_due_date"/>
        </createIndex>
    </changeSet>

    <!-- LLM cost-per-course sum: covering index so the SUM over the token/cost columns needs no row lookups.
         The FK-backing index on (trace_id) is intentionally kept. -->
    <changeSet id="20260718130000-09-create-idx-llm-token-usage-request-trace-cost" author="krusche">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_llm_token_usage_request_trace_cost" tableName="llm_token_usage_request"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_llm_token_usage_request_trace_cost" tableName="llm_token_usage_request">
            <column name="trace_id"/>
            <column name="num_input_tokens"/>
            <column name="cost_per_million_input_tokens"/>
            <column name="num_output_tokens"/>
            <column name="cost_per_million_output_tokens"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
