<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20260922004543-01-retain-recovery-version-authorship" author="FelixTJDietrich">
        <comment>Allow canonical recovery versions to survive permanent account deletion without an author identity.</comment>
        <dropNotNullConstraint tableName="exercise_version" columnName="author_id" columnDataType="bigint"/>
        <!-- Anonymized identities cannot be reconstructed. Schema rollback requires the pre-migration database backup. -->
        <rollback>
            <addNotNullConstraint tableName="exercise_version" columnName="author_id" columnDataType="bigint"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
