<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Build group shared by the container jobs of one multi-container build, under which their results are merged;
         null for a single-container job. -->
    <changeSet id="20260903140000-01-add-build-group-id-to-build-job" author="greinwald">
        <addColumn tableName="build_job">
            <column name="build_group_id" type="varchar(255)"/>
        </addColumn>
        <createIndex indexName="idx_build_job_build_group_id" tableName="build_job">
            <column name="build_group_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
