<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20260325-1-add-default" author="PeterNiedermoser">

        <createTable tableName="participation_iris_reasoning">
            <column name="participation_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="reason" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="participation_iris_reasoning"
                columnNames="participation_id, reason"
                constraintName="pk_participation_iris_reasoning"/>

        <addForeignKeyConstraint
                baseTableName="participation_iris_reasoning"
                baseColumnNames="participation_id"
                referencedTableName="participation"
                referencedColumnNames="id"
                constraintName="fk_participation_iris_reasoning"/>

        <createIndex tableName="participation_iris_reasoning"
                     indexName="idx_participation_iris_reasoning">
            <column name="participation_id"/>
        </createIndex>

        <addColumn tableName="participation">
            <column name="iris_verdict" type="VARCHAR(255)"/>
            <column name="iris_verified_score" type="DOUBLE"/>
        </addColumn>

    </changeSet>
</databaseChangeLog>