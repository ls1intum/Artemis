<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Whether the build a job ran failed to build, which its status does not record; a build group derives the
         submission's build-failed flag from its jobs. -->
    <changeSet id="20260923120000-01-add-build-failed-to-build-job" author="greinwald">
        <addColumn tableName="build_job">
            <column name="build_failed" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
