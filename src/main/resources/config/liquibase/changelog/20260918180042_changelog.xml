<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
    An analysis of the database structure found that a build configuration had no key of its own. The exercise pointed
    at it through a nullable column, so nothing tied the configuration to the exercise it configures and deleting the
    exercise left the row behind for good.

    The configuration now holds the key. A deleted exercise takes its build configuration with it, and a configuration
    that belongs to no exercise can no longer be written.
    -->

    <changeSet id="20260918180042-01-build-configuration-owns-its-exercise-key" author="krusche">
        <comment>Move the exercise key onto the build configuration, so that it cannot outlive the exercise it configures.</comment>
        <addColumn tableName="programming_exercise_build_config">
            <column name="exercise_id" type="BIGINT"/>
        </addColumn>
        <sql>UPDATE programming_exercise_build_config SET exercise_id =
            (SELECT details.id FROM programming_exercise_details details WHERE details.programming_exercise_build_config_id = programming_exercise_build_config.id);</sql>
        <!--
        A configuration no exercise points at configures nothing. It carried no key of its own, and nothing lists one
        except through the exercise that named it, so it has been unreachable from the moment the exercise stopped
        naming it.
        -->
        <sql>DELETE FROM programming_exercise_build_config WHERE exercise_id IS NULL;</sql>
        <addUniqueConstraint tableName="programming_exercise_build_config" columnNames="exercise_id" constraintName="UK_BUILD_CONFIG_EXERCISE"/>
        <addForeignKeyConstraint baseTableName="programming_exercise_build_config" baseColumnNames="exercise_id" constraintName="FK_BUILD_CONFIG_EXERCISE"
                                 referencedTableName="exercise" referencedColumnNames="id" onDelete="CASCADE"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="programming_exercise_build_config" constraintName="FK_BUILD_CONFIG_EXERCISE"/>
            <dropUniqueConstraint tableName="programming_exercise_build_config" constraintName="UK_BUILD_CONFIG_EXERCISE"/>
            <dropColumn tableName="programming_exercise_build_config" columnName="exercise_id"/>
        </rollback>
    </changeSet>

    <changeSet id="20260918180042-02-build-configuration-exercise-not-null" author="krusche">
        <preConditions onFail="CONTINUE">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM programming_exercise_build_config WHERE exercise_id IS NULL</sqlCheck>
        </preConditions>
        <addNotNullConstraint tableName="programming_exercise_build_config" columnName="exercise_id" columnDataType="BIGINT"/>
        <rollback>
            <dropNotNullConstraint tableName="programming_exercise_build_config" columnName="exercise_id" columnDataType="BIGINT"/>
        </rollback>
    </changeSet>

    <changeSet id="20260918180042-03-programming-exercises-stop-pointing-at-their-build-configuration" author="krusche">
        <comment>The build configuration holds the key, so the exercise no longer points back.</comment>
        <dropForeignKeyConstraint baseTableName="programming_exercise_details" constraintName="fk_programming_exercise_build_config"/>
        <dropColumn tableName="programming_exercise_details" columnName="programming_exercise_build_config_id"/>
        <rollback>
            <addColumn tableName="programming_exercise_details">
                <column name="programming_exercise_build_config_id" type="BIGINT"/>
            </addColumn>
            <sql>UPDATE programming_exercise_details SET programming_exercise_build_config_id =
                (SELECT config.id FROM programming_exercise_build_config config WHERE config.exercise_id = programming_exercise_details.id);</sql>
            <addForeignKeyConstraint baseTableName="programming_exercise_details" baseColumnNames="programming_exercise_build_config_id"
                                     constraintName="fk_programming_exercise_build_config" referencedTableName="programming_exercise_build_config"
                                     referencedColumnNames="id" onDelete="CASCADE"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
