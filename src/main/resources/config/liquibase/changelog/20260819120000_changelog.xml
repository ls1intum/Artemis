<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
    Change the build_plan_configuration and docker_flags columns of programming_exercise_build_config from LONGTEXT
    to MEDIUMTEXT on MySQL. Both columns are nullable with no default, so modifyDataType keeps them nullable.
    Both columns store JSON. Any row whose value exceeds the MEDIUMTEXT byte limit (16777215) is reset to NULL before
    the type is narrowed, so the modifyDataType cannot fail or leave a value truncated into malformed JSON. NULL is the
    "use the default configuration" state for both fields, so the row stays valid. This discards the oversized value
    (data loss); these values are above the supported build configuration size limit.
    PostgreSQL has no MEDIUMTEXT; the column stays text there.
    -->
    <changeSet id="20260819120000-1" author="harbeck">
        <preConditions onFail="MARK_RAN">
            <dbms type="mysql"/>
        </preConditions>

        <!-- Reset values that exceed the MEDIUMTEXT byte limit to NULL (the default configuration) before narrowing the column type. -->
        <sql>
            UPDATE programming_exercise_build_config
            SET build_plan_configuration = NULL
            WHERE OCTET_LENGTH(build_plan_configuration) > 16777215;
        </sql>
        <sql>
            UPDATE programming_exercise_build_config
            SET docker_flags = NULL
            WHERE OCTET_LENGTH(docker_flags) > 16777215;
        </sql>

        <modifyDataType tableName="programming_exercise_build_config" columnName="build_plan_configuration" newDataType="MEDIUMTEXT"/>
        <modifyDataType tableName="programming_exercise_build_config" columnName="docker_flags" newDataType="MEDIUMTEXT"/>
    </changeSet>

</databaseChangeLog>
