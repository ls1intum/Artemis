<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
    Change the build_plan_configuration and docker_flags columns of programming_exercise_build_config from LONGTEXT
    to MEDIUMTEXT on MySQL. Both columns are nullable with no default, so modifyDataType does not drop NOT NULL/DEFAULT.
    PostgreSQL has no MEDIUMTEXT; the column stays text there.
    -->
    <changeSet id="20260707120000-1" author="harbeck">
        <preConditions onFail="MARK_RAN">
            <dbms type="mysql"/>
        </preConditions>
        <modifyDataType tableName="programming_exercise_build_config" columnName="build_plan_configuration" newDataType="MEDIUMTEXT"/>
        <modifyDataType tableName="programming_exercise_build_config" columnName="docker_flags" newDataType="MEDIUMTEXT"/>
    </changeSet>

</databaseChangeLog>
