<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
    Change the build_plan_configuration and docker_flags columns of programming_exercise_build_config from LONGTEXT
    to MEDIUMTEXT on MySQL. Both columns are nullable with no default, so modifyDataType does not drop NOT NULL/DEFAULT.
    Any row that exceeds the MEDIUMTEXT byte limit (16777215) is shortened before the type is narrowed, so the
    modifyDataType cannot fail or truncate silently. The shortening uses LEFT (by character), which keeps the value
    valid and, at MySQL's maximum of 4 bytes per character, stays within the limit (4194303 * 4 = 16777212 bytes).
    PostgreSQL has no MEDIUMTEXT; the column stays text there.
    -->
    <changeSet id="20260707120000-1" author="harbeck">
        <preConditions onFail="MARK_RAN">
            <dbms type="mysql"/>
        </preConditions>

        <!-- Shorten values that exceed the MEDIUMTEXT byte limit before narrowing the column type. -->
        <sql>
            UPDATE programming_exercise_build_config
            SET build_plan_configuration = LEFT(build_plan_configuration, 4194303)
            WHERE OCTET_LENGTH(build_plan_configuration) > 16777215;
        </sql>
        <sql>
            UPDATE programming_exercise_build_config
            SET docker_flags = LEFT(docker_flags, 4194303)
            WHERE OCTET_LENGTH(docker_flags) > 16777215;
        </sql>

        <modifyDataType tableName="programming_exercise_build_config" columnName="build_plan_configuration" newDataType="MEDIUMTEXT"/>
        <modifyDataType tableName="programming_exercise_build_config" columnName="docker_flags" newDataType="MEDIUMTEXT"/>
    </changeSet>

</databaseChangeLog>
