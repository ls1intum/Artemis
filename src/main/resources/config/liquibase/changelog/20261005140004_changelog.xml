<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
    A plagiarism detection configuration had no key of its own. The exercise pointed at it through a nullable column, so nothing tied the configuration to
    the exercise it configures, and deleting the exercise could leave the row behind for good.

    Every exercise owns exactly one permanent row. The configuration holds the key, a deleted exercise takes it along through the
    database, and a configuration that belongs to no exercise can no longer be written. Settings never insert or delete the row,
    they only update it.

    DDL commits implicitly on MySQL, so every step is its own changeset and can be repeated after an interruption: the
    structural steps check for themselves, and the statements only touch what is still unfinished.
    -->

    <changeSet id="20261005140004-01-stop-on-a-configuration-shared-by-several-exercises" author="krusche">
        <!-- Two exercises cannot share a configuration. If they do, nothing says which one owns it, so the upgrade stops rather than guessing. -->
        <preConditions onFail="HALT" onFailMessage="Several exercises point at the same row of plagiarism_detection_config. Give each exercise its own row (copy the row and update exercise.plagiarism_detection_config_id) or remove the duplicate pointer, then start the server again.">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM (SELECT plagiarism_detection_config_id FROM exercise WHERE plagiarism_detection_config_id IS NOT NULL
                GROUP BY plagiarism_detection_config_id HAVING COUNT(*) &gt; 1) shared</sqlCheck>
        </preConditions>
        <comment>Only checks the precondition; the statement changes nothing.</comment>
        <sql>DELETE FROM plagiarism_detection_config WHERE 1 = 0;</sql>
        <rollback/>
    </changeSet>

    <changeSet id="20261005140004-02-add-exercise-key-to-plagiarism-detection-config" author="krusche">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="plagiarism_detection_config" columnName="exercise_id"/></not>
        </preConditions>
        <comment>The key of the exercise moves onto the configuration, so that it cannot outlive the exercise it configures.</comment>
        <addColumn tableName="plagiarism_detection_config">
            <column name="exercise_id" type="BIGINT"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="plagiarism_detection_config" columnName="exercise_id"/>
        </rollback>
    </changeSet>

    <changeSet id="20261005140004-04-set-exercise-key-of-plagiarism-detection-config" author="krusche">
        <comment>The exercise that pointed at a configuration becomes its key. Only configurations without a key are filled, so a repeated run changes nothing.</comment>
        <sql>UPDATE plagiarism_detection_config SET exercise_id =
            (SELECT MIN(exercise.id) FROM exercise WHERE exercise.plagiarism_detection_config_id = plagiarism_detection_config.id)
            WHERE exercise_id IS NULL;</sql>
        <rollback/>
    </changeSet>

    <changeSet id="20261005140004-06-remove-plagiarism-detection-config-no-exercise-points-at" author="krusche">
        <comment>Remove the plagiarism detection configurations that no exercise points at.</comment>
        <!--
        A configuration no exercise points at configures nothing. It carried no key of its own, and nothing lists one except through
        the exercise that named it, so it has been unreachable from the moment the exercise stopped naming it. Nothing else references
        the table, so the statement removes nothing but the rows themselves.
        -->
        <sql>DELETE FROM plagiarism_detection_config WHERE exercise_id IS NULL;</sql>
        <rollback/>
    </changeSet>

    <changeSet id="20261005140004-07-one-plagiarism-detection-config-per-exercise" author="krusche">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="plagiarism_detection_config" indexName="UK_PLAGIARISM_DETECTION_CONFIG_EXERCISE"/></not>
        </preConditions>
        <addUniqueConstraint tableName="plagiarism_detection_config" columnNames="exercise_id" constraintName="UK_PLAGIARISM_DETECTION_CONFIG_EXERCISE"/>
        <rollback>
            <dropUniqueConstraint tableName="plagiarism_detection_config" constraintName="UK_PLAGIARISM_DETECTION_CONFIG_EXERCISE"/>
        </rollback>
    </changeSet>

    <changeSet id="20261005140004-08-give-every-exercise-a-plagiarism-detection-config" author="krusche">
        <comment>Every exercise owns a permanent row. The earlier backfill gave every existing exercise one, so this only closes the window in which an exercise was created by a server that does not know the new rule; the unique key makes it safe to repeat.</comment>
        <sql>INSERT INTO plagiarism_detection_config (exercise_id, continuous_plagiarism_control_enabled, continuous_plagiarism_control_post_due_date_checks_enabled, continuous_plagiarism_control_case_student_response_period, similarity_threshold, minimum_score, minimum_size)
            SELECT exercise.id, FALSE, FALSE, 7, 90, 0, 50 FROM exercise
            WHERE NOT EXISTS (SELECT 1 FROM plagiarism_detection_config existing WHERE existing.exercise_id = exercise.id);</sql>
        <rollback/>
    </changeSet>

    <changeSet id="20261005140004-09-plagiarism-detection-config-exercise-key-not-null" author="krusche">
        <addNotNullConstraint tableName="plagiarism_detection_config" columnName="exercise_id" columnDataType="BIGINT"/>
        <rollback>
            <dropNotNullConstraint tableName="plagiarism_detection_config" columnName="exercise_id" columnDataType="BIGINT"/>
        </rollback>
    </changeSet>

    <changeSet id="20261005140004-10-plagiarism-detection-config-follows-its-exercise" author="krusche">
        <preConditions onFail="MARK_RAN">
            <not><foreignKeyConstraintExists foreignKeyTableName="plagiarism_detection_config" foreignKeyName="FK_PLAGIARISM_DETECTION_CONFIG_EXERCISE"/></not>
        </preConditions>
        <addForeignKeyConstraint baseTableName="plagiarism_detection_config" baseColumnNames="exercise_id" constraintName="FK_PLAGIARISM_DETECTION_CONFIG_EXERCISE"
                                 referencedTableName="exercise" referencedColumnNames="id" onDelete="CASCADE"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="plagiarism_detection_config" constraintName="FK_PLAGIARISM_DETECTION_CONFIG_EXERCISE"/>
        </rollback>
    </changeSet>

    <changeSet id="20261005140004-11-exercises-stop-pointing-at-their-plagiarism-detection-config-constraint" author="krusche">
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists foreignKeyTableName="exercise" foreignKeyName="FK_EXERCISE_ON_PLAGIARISM_DETECTION_CONFIG"/>
        </preConditions>
        <comment>The configuration holds the key, so the exercise no longer points at it.</comment>
        <dropForeignKeyConstraint baseTableName="exercise" constraintName="FK_EXERCISE_ON_PLAGIARISM_DETECTION_CONFIG"/>
        <rollback>
            <addForeignKeyConstraint baseTableName="exercise" baseColumnNames="plagiarism_detection_config_id" constraintName="FK_EXERCISE_ON_PLAGIARISM_DETECTION_CONFIG"
                                     referencedTableName="plagiarism_detection_config" referencedColumnNames="id" onDelete="RESTRICT"/>
        </rollback>
    </changeSet>

    <changeSet id="20261005140004-12-exercises-stop-pointing-at-their-plagiarism-detection-config" author="krusche">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="exercise" columnName="plagiarism_detection_config_id"/>
        </preConditions>
        <comment>Dropping the column also drops the indexes that only cover it.</comment>
        <dropColumn tableName="exercise" columnName="plagiarism_detection_config_id"/>
        <rollback>
            <addColumn tableName="exercise">
                <column name="plagiarism_detection_config_id" type="BIGINT"/>
            </addColumn>
            <sql>UPDATE exercise SET plagiarism_detection_config_id =
                (SELECT config.id FROM plagiarism_detection_config config WHERE config.exercise_id = exercise.id);</sql>
            <createIndex indexName="FK_EXERCISE_ON_PLAGIARISM_DETECTION_CONFIG" tableName="exercise">
                <column name="plagiarism_detection_config_id"/>
            </createIndex>
        </rollback>
    </changeSet>

</databaseChangeLog>
