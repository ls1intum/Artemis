<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Remove user_recovery_key.reset_key and replace it with two columns for id and hash -->
    <changeSet id="20260830210000-1" author="angatha and Lion Holtkötter">
        <renameColumn tableName="user_recovery_key" oldColumnName="reset_key" newColumnName="reset_key_id"/>
        <!-- Legacy reset links cannot be reused with the new ID/secret format. Preserve pending activations. -->
        <update tableName="user_recovery_key">
            <column name="reset_key_id" valueComputed="NULL"/>
            <column name="reset_date" valueComputed="NULL"/>
        </update>
        <addColumn tableName="user_recovery_key">
            <column name="reset_key_hash" type="varchar(255)"/>
        </addColumn>
        <delete tableName="user_recovery_key">
            <where>activation_key IS NULL AND reset_key_id IS NULL AND reset_key_hash IS NULL AND reset_date IS NULL</where>
        </delete>
    </changeSet>
</databaseChangeLog>
