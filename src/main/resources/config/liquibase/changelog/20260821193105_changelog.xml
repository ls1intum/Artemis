<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Move the LTI provisioning marker out of jhi_user. Three accounts out of 34,354 carry it, and it is state the lti
        module owns rather than the account module, so it does not belong in that module's central table.

        A row exists only for an account the launch created, so the absence of a row means "not launch-created" - what
        lti_created = false meant before.

        LT-2 (separate follow-up PR after staging sign-off): DROP jhi_user.lti_created.
    -->
    <changeSet id="20260821193105-1-create-user-lti" author="krusche">
        <createTable tableName="user_lti">
            <column name="user_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_by_launch" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="user_lti" baseColumnNames="user_id" constraintName="fk_user_lti_user" referencedTableName="jhi_user"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="20260821193105-2-backfill" author="krusche">
        <sql>
            INSERT INTO user_lti (user_id, created_by_launch)
            SELECT id, TRUE FROM jhi_user WHERE lti_created = TRUE
        </sql>
        <rollback>
            <sql>DELETE FROM user_lti</sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
