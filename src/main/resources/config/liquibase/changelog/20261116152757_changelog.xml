<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20261116152757-01-llm-usd-cost" author="bassner">
        <comment>Keep historical rates unchanged; only explicitly priced USD requests have a USD total.</comment>
        <addColumn tableName="llm_token_usage_request">
            <column name="total_cost_usd" type="double"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="llm_token_usage_request" columnName="total_cost_usd"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
