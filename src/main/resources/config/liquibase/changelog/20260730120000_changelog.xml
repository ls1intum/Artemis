<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260730120000-1" author="maximiliananzinger">
        <addColumn tableName="science_event">
            <column name="course_id" type="bigint"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260730120000-2" author="maximiliananzinger">
        <comment>Backfill course ids for legacy science events where the original resource id can be resolved deterministically.</comment>
        <sql>
            UPDATE science_event
            SET course_id = (SELECT lecture.course_id FROM lecture WHERE lecture.id = science_event.resource_id)
            WHERE event_type = 0 AND course_id IS NULL
              AND EXISTS (SELECT 1 FROM lecture WHERE lecture.id = science_event.resource_id);
        </sql>
        <sql>
            UPDATE science_event
            SET course_id = (
                SELECT lecture.course_id
                FROM lecture_unit
                JOIN lecture ON lecture.id = lecture_unit.lecture_id
                WHERE lecture_unit.id = science_event.resource_id
            )
            WHERE event_type = 1 AND course_id IS NULL
              AND EXISTS (
                SELECT 1
                FROM lecture_unit
                JOIN lecture ON lecture.id = lecture_unit.lecture_id
                WHERE lecture_unit.id = science_event.resource_id
              );
        </sql>
        <sql>
            UPDATE science_event
            SET course_id = (SELECT exercise.course_id FROM exercise WHERE exercise.id = science_event.resource_id)
            WHERE event_type = 2 AND course_id IS NULL
              AND EXISTS (SELECT 1 FROM exercise WHERE exercise.id = science_event.resource_id);
        </sql>
        <sql>
            UPDATE science_event
            SET course_id = (SELECT competency.course_id FROM competency WHERE competency.id = science_event.resource_id)
            WHERE event_type = 3 AND course_id IS NULL
              AND EXISTS (SELECT 1 FROM competency WHERE competency.id = science_event.resource_id);
        </sql>
        <sql>
            UPDATE science_event
            SET course_id = resource_id
            WHERE event_type = 4 AND course_id IS NULL
              AND EXISTS (SELECT 1 FROM course WHERE course.id = science_event.resource_id);
        </sql>
        <sql>
            UPDATE science_event
            SET course_id = (SELECT learning_path.course_id FROM learning_path WHERE learning_path.id = science_event.resource_id)
            WHERE event_type IN (5, 6, 7, 8, 9) AND course_id IS NULL
              AND EXISTS (SELECT 1 FROM learning_path WHERE learning_path.id = science_event.resource_id);
        </sql>
        <sql>
            UPDATE science_event
            SET course_id = resource_id
            WHERE event_type IN (10, 11) AND course_id IS NULL
              AND EXISTS (SELECT 1 FROM course WHERE course.id = science_event.resource_id);
        </sql>
    </changeSet>

    <changeSet id="20260730120000-3" author="maximiliananzinger">
        <createTable tableName="science_enabled_course">
            <column autoIncrement="true" name="id" type="bigint">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="course_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="datetime(3)"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="datetime(3)"/>
        </createTable>
        <addUniqueConstraint columnNames="course_id" constraintName="UKScienceEnabledCourseCourseId" tableName="science_enabled_course"/>
        <addForeignKeyConstraint baseColumnNames="course_id" baseTableName="science_enabled_course" constraintName="FKScienceEnabledCourseCourseId" onDelete="CASCADE"
                                 referencedColumnNames="id" referencedTableName="course"/>
    </changeSet>

