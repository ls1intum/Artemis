        <addForeignKeyConstraint baseColumnNames="course_id" baseTableName="science_course_consent" constraintName="FKScienceCourseConsentCourseId" onDelete="CASCADE"
                                 referencedColumnNames="id" referencedTableName="course"/>
    </changeSet>

