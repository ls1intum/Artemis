org.springframework.boot.autoconfigure.AutoConfigurationImportFilter=\
de.tum.cit.aet.artemis.core.config.SpringAIAutoConfigurationFilter

org.springframework.boot.EnvironmentPostProcessor=\
de.tum.cit.aet.artemis.core.config.RedisDiscoveryEnvironmentPostProcessor

org.springframework.boot.diagnostics.FailureAnalyzer=\
de.tum.cit.aet.artemis.core.exception.failureAnalyzer.ConflictingPasskeyConfigurationFailureAnalyzer,\
de.tum.cit.aet.artemis.core.exception.failureAnalyzer.InsecureDefaultCredentialFailureAnalyzer,\
de.tum.cit.aet.artemis.core.exception.failureAnalyzer.InvalidAdminConfigurationFailureAnalyzer,\
de.tum.cit.aet.artemis.globalsearch.exception.failureAnalyzer.WeaviateAuthenticationFailureAnalyzer,\
de.tum.cit.aet.artemis.globalsearch.exception.failureAnalyzer.WeaviateConfigurationFailureAnalyzer,\
de.tum.cit.aet.artemis.globalsearch.exception.failureAnalyzer.WeaviateConnectionFailureAnalyzer
