{
    "name": "artemis_playwright",
    "description": "Playwright tests for Artemis",
    "private": true,
    "license": "MIT",
    "packageManager": "pnpm@11.22.0",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.62.1",
        "@types/lodash-es": "4.17.12",
        "@typescript-eslint/eslint-plugin": "8.67.0",
        "@typescript-eslint/parser": "8.67.0",
        "archiver": "8.0.0",
        "cross-env": "10.1.0",
        "dayjs": "1.11.21",
        "dotenv": "17.4.2",
        "eslint": "10.8.1",
        "istanbul-lib-coverage": "3.2.2",
        "istanbul-lib-report": "3.0.1",
        "istanbul-reports": "3.2.0",
        "junit-merge": "2.0.0",
        "lodash-es": "4.18.1",
        "monocart-reporter": "2.12.5",
        "npm-check-updates": "23.0.2",
        "simple-git": "3.36.0",
        "uuid": "14.0.1"
    },
    "scripts": {
        "playwright:test": "cross-env bash ./run-tests.sh",
        "playwright:open": "playwright test e2e --ui",
        "playwright:setup": "pnpm exec playwright install chromium firefox webkit && playwright test init",
        "playwright:setup-local": "pnpm exec playwright install --with-deps chromium firefox webkit",
        "playwright:init": "playwright test init",
        "merge-coverage-reports": "node ./merge-coverage-reports.mjs",
        "update": "ncu -i --format group",
        "pretest": "tsc --incremental -p tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint --fix ."
    }
}
