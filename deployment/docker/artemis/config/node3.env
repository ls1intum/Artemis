SPRING_PROFILES_ACTIVE='prod,buildagent'
EUREKA_INSTANCE_INSTANCEID='Artemis:3'
EUREKA_INSTANCE_HOSTNAME='artemis-app-node-3'
SPRING_HAZELCAST_INTERFACE='artemis-app-node-3'

# Distinct build agent identity. Without it both build-agent nodes take the shipped default short name and overwrite
# each other's entry in the distributed build agent map, so the stack silently exercises one agent instead of two.
ARTEMIS_CONTINUOUSINTEGRATION_BUILDAGENT_SHORTNAME="artemis-build-agent-3"
ARTEMIS_CONTINUOUSINTEGRATION_BUILDAGENT_DISPLAYNAME="Artemis Build Agent 3"
