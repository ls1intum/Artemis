# Applied to the dedicated LocalCI process only. The deployment may supply
# runner limits and proxy settings through ARTEMIS_BUILDAGENT_ENV_FILE.
_JAVA_OPTIONS="-Xms128m -Xmx512m"
ARTEMIS_CONTINUOUSINTEGRATION_BUILDAGENT_SHORTNAME=artemis-buildagent
ARTEMIS_CONTINUOUSINTEGRATION_BUILDAGENT_DISPLAYNAME="Test Server Build Agent"
ARTEMIS_CONTINUOUSINTEGRATION_SPECIFYCONCURRENTBUILDS=true
ARTEMIS_CONTINUOUSINTEGRATION_CONCURRENTBUILDSIZE=1
ARTEMIS_CHECKEDOUTREPOSPATH=/opt/artemis/data/checked-out-repos
ARTEMIS_VERSIONCONTROL_BUILDAGENTUSESSH=true
ARTEMIS_VERSIONCONTROL_SSHPRIVATEKEYFOLDERPATH=/opt/artemis/data/ssh
ARTEMIS_VERSIONCONTROL_SSHTEMPLATECLONEURL="ssh://git@${NGINX_PUBLIC_HOSTNAME:-artemis-nginx}:7921/"
