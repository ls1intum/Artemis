# Core node with a build agent.
# `prod` must stay AFTER `buildagent`: buildagent sets `spring.jpa.database: default` and prod disables
# the JDBC metadata probe. prod must win the `database` key (POSTGRESQL) or Hibernate cannot determine
# the dialect on this combined member+build-agent node and it fails to start. See node2.env.
SPRING_PROFILES_ACTIVE="localvc,localci,buildagent,core,prod,docker"
SPRING_DATA_REDIS_CLIENTNAME="artemis-node-2"
ARTEMIS_INSTANCEID="artemis-node-2"
SERVER_PORT="8081"
ARTEMIS_VERSIONCONTROL_SSHPORT="7922"

# Distinct build agent identity. Without it both build-agent nodes take the shipped default short name and overwrite
# each other's entry in the distributed build agent map, so the stack silently exercises one agent instead of two.
ARTEMIS_CONTINUOUSINTEGRATION_BUILDAGENT_SHORTNAME="artemis-build-agent-2"
ARTEMIS_CONTINUOUSINTEGRATION_BUILDAGENT_DISPLAYNAME="Artemis Build Agent 2"
# Enable LTI so the cross-node LTI test in DistributedStateCoherence.spec.ts runs. The signing key of each LTI
# platform lives in a distributed map, so a key written on one core node has to be served by the other core node's
# JWKS endpoint. Core nodes only: a build-agent node has no LTI repositories and refuses to start with LTI on.
ARTEMIS_LTI_ENABLED="true"
